let rwBulkRows=[],rwBulkFile=null;
const rwClean=v=>String(v==null?'':v).replace(/<[^>]*>/g,' ').replace(/&amp;/g,'&').replace(/&nbsp;/g,' ').replace(/\s+/g,' ').trim();
function rwParseDate(v){
  if(v==null||v==='')return '';
  if(v instanceof Date)return v.toISOString().slice(0,10);
  const s=String(v).trim();
  let m=s.match(/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{4})$/);            // dd/mm/yyyy (the format in this export)
  if(m)return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
  m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return `${m[1]}-${m[2]}-${m[3]}`;
  const n=Number(s);
  if(!isNaN(n)&&n>20000&&n<60000){const d=XLSX.SSF.parse_date_code(n);if(d)return `${d.y}-${String(d.m).padStart(2,'0')}-${String(d.d).padStart(2,'0')}`}
  return '';
}
function rwResultKey(v){
  const s=rwClean(v).toUpperCase();
  if(!s)return '';
  if(s.includes('PASS'))return 'passed';
  if(s.includes('CONCESSION'))return 'concession';
  if(s.includes('REPLACE'))return 'rejected';
  return 'other';
}
const rwQtyCell=v=>{const s=rwClean(v);if(s==='')return null;const n=parseInt(s,10);return isNaN(n)?null:Math.max(0,n)};
function rwExtract(wb){
  const out=[],errors=[];let skipped=0;
  wb.SheetNames.forEach(name=>{
    const rows=XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,defval:'',raw:true,blankrows:false});
    const hi=rows.findIndex(r=>r.some(c=>/^ref\.? ?no$/i.test(rwClean(c))));
    if(hi<0){errors.push(`Sheet "${name}": no header row with "Ref No" found, skipped.`);return}
    const head=rows[hi].map(c=>rwClean(c).toLowerCase());
    const col=(...kw)=>head.findIndex(h=>kw.every(k=>h.includes(k)));
    const C={date:col('date'),ref:head.findIndex(h=>/^ref\.? ?no$/.test(h)),ticket:col('ticket'),res:col('checking'),by:col('inspected'),
      rwCode:col('rework','code'),rwCat:col('rework','category'),rwReason:col('rework','reason'),rwQty:col('rework','quantity'),rwOp:col('rework','operator'),
      rpCat:col('replacement','category'),rpReason:col('replacement','reason'),rpQty:col('replacement','quantity')};
    const get=(r,k)=>C[k]<0?'':r[C[k]];
    rows.slice(hi+1).forEach(r=>{
      const ref=rwClean(get(r,'ref'));
      if(!ref){if(r.some(c=>rwClean(c)!==''))skipped++;return}
      out.push({sheet:name,inspection_date:rwParseDate(get(r,'date')),ref_no:ref,so_no:rwClean(get(r,'ticket')),result:rwResultKey(get(r,'res')),
        inspected_by:rwClean(get(r,'by')),rw_process_code:rwClean(get(r,'rwCode')),rw_category:rwClean(get(r,'rwCat')),rw_reason:rwClean(get(r,'rwReason')),
        rw_qty:rwQtyCell(get(r,'rwQty')),rw_operator:rwClean(get(r,'rwOp')),rp_category:rwClean(get(r,'rpCat')),rp_reason:rwClean(get(r,'rpReason')),rp_qty:rwQtyCell(get(r,'rpQty'))});
    });
  });
  if(skipped)errors.push(`${skipped} row(s) without a Ref No were skipped.`);
  return {records:out,errors,sheets:wb.SheetNames.length};
}
const rwToRec=r=>({ref:r.ref_no,rwCode:r.rw_process_code,rwCat:r.rw_category,rwReason:r.rw_reason,rwQty:r.rw_qty,rwOp:r.rw_operator,rpCat:r.rp_category,rpReason:r.rp_reason,rpQty:r.rp_qty});
/* Marks every row with its line key and its number (1st, 2nd... identical line in this file) and whether it's already in the database. */
function rwAnalyse(rows){
  const seen={};
  rows.forEach(r=>{
    r._key=rwLineKey(rwToRec(r));seen[r._key]=(seen[r._key]||0)+1;r._occ=seen[r._key];
    r._dup=RW.some(x=>x.lineKey===r._key&&x.occ===r._occ);
    r._review=r.result===''||r.result==='other';
  });
}
function rwRenderBulkPreview(errors,sheets){

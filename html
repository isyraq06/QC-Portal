    if(rank){const nums=head.slice(2).map(h=>h==='Running total'?1.1:0.85);colW=[0.45,w-0.45-nums.reduce((a,b)=>a+b,0)].concat(nums)}
    else colW=head.map((_,i)=>i?(w-1.1)/(head.length-1):1.1);
    sl.addTable([hdr,...body],{x,y,w,colW,fontFace:F,rowH:Math.min(0.34,4.1/(rows.length+1)),border:{type:'solid',pt:0.5,color:'E3EAF0'},valign:'middle',margin:[0,0.08,0,0.08]});
  };
  const fullSlides=()=>{
    parts.forEach(p=>{
      const T=expPartTable(p),grp=p.grp==='ca'?'CONCESSION ACCEPT':'REWORK',rank=p.kind!=='monthly';
      const blocks=p.kind==='monthly'?[T.rows]:expChunks(T.rows,12),gmax=p.items.length?p.items[0].n:1;
      let start=0;
      blocks.forEach((rows,bi)=>{
        const sl=base(grp,p.title+(blocks.length>1?`  (${bi+1}/${blocks.length})`:''),p.period);
        const wide=p.kind==='monthly'||p.kind==='pareto',tw=wide?5.7:4.6,cw=W-1.1-tw-0.18,tx=0.55+cw+0.18;
        const sub=p.kind==='monthly'?p.desc:`${p.desc} ${T.rows.length} row${T.rows.length===1?'':'s'}${blocks.length>1?', showing '+(start+1)+' to '+(start+rows.length):''}.`;
        card(sl,0.55,1.45,cw,5.43);heading(sl,p.title,0.75,1.57,cw-0.4,sub);
        card(sl,tx,1.45,tw,5.43);heading(sl,'The numbers',tx+0.2,1.57,tw-0.4,p.kind==='monthly'?'Items per month by result.':'Share is out of '+T.total.toLocaleString('en-GB')+'.');
        if(p.kind==='monthly')monthlyChart(sl,0.7,2.35,cw-0.3,4.4,p);
        else hbar(sl,0.7,2.3,cw-0.3,4.5,rows.map(r=>p.kind==='pareto'?`${expShort(r[1],34)} (${r[3]})`:expShort(r[1],40)),rows.map(r=>r[2]),EXP_C.accent,'Nothing to show for this period.',gmax*1.12);
        numTable(sl,tx+0.12,2.3,tw-0.25,T.head,rows,rank,10.5);
        start+=rows.length;
      });
    });
  };

  if(FULL){fullSlides()}
  else{
    overview('CONCESSION ACCEPT','Concession Accept Overview',D.ca,[{title:'Rejects by defect type',bars:D.ca.bars,empty:'No defects logged.'}],'Recent inspection records');
    insights('CONCESSION ACCEPT','Concession Accept',D.ca);
    overview('REWORK','Rework Overview',D.rw,[{title:'Rework by defect category',bars:D.rw.bars,empty:'No rework logged.'},{title:'Replacement by defect category',bars:D.rw.bars2,empty:'No replacement logged.'}],'Recent Rework records');
    insights('REWORK','Rework',D.rw);
  }

  /* page numbers (the cover has none) */
  pages.forEach((sl,i)=>sl.addText((i+1)+' / '+pages.length,{x:W-1.7,y:7.06,w:1.15,h:0.28,fontFace:F,fontSize:10,color:EXP_C.muted,align:'right',margin:0}));
  return P;
}

let expBusy=false;
async function exportPPTX(parts){
  if(expBusy)return;expBusy=true;
  const full=Array.isArray(parts);
  const btn=$('#expBtn'),old=btn.innerHTML;btn.disabled=true;btn.textContent='Preparing slides…';
  try{
    await expLoadPptx();
    const D=expCollect(),deck=expBuildDeck(D,full?'full':'',parts);
    const d=new Date(),pad=x=>String(x).padStart(2,'0');
    await deck.writeFile({fileName:`QC-Dashboard-${full?'Full':'Summary'}-${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}.pptx`});
    toast('PowerPoint downloaded');
  }catch(err){
    console.error('PowerPoint export failed:',err);
    toast('Could not make the PowerPoint. Check your internet connection and try again.',{type:'error'});
  }finally{btn.disabled=false;btn.innerHTML=old;hydrateIcons(btn);expBusy=false}
}

function setupExport(){
  const btn=$('#expBtn'),menu=$('#expMenu');if(!btn||!menu)return;
  const close=()=>{menu.hidden=true;btn.setAttribute('aria-expanded','false')};
  btn.onclick=e=>{e.stopPropagation();const fg=$('#expFull');if(fg)fg.hidden=!vzAdmin();   // Full record is for administrators (the same people who see the Insights charts)
    const open=menu.hidden;menu.hidden=!open;btn.setAttribute('aria-expanded',String(open));if(open)$('button',menu).focus()};
  document.addEventListener('click',e=>{if(!menu.hidden&&!e.target.closest('.expwrap'))close()});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!menu.hidden){close();btn.focus()}});
  $$('button[data-exp]',menu).forEach(b=>b.onclick=()=>{close();b.dataset.exp==='pdf'?exportPDF():exportPPTX()});

  /* ---- Full record (Option B): side panel with a card for every part ---- */
  const UI=[
    ['ca1','ca','bars','Rejects by defect type','Records per defect type'],
    ['ca2','ca','pareto','Defects, biggest first','Pareto: share and running total'],
    ['ca3','ca','bars','Records by material','Every material, ranked'],
    ['ca4','ca','bars','Records by accepted-by','Who handled the records'],
    ['rw1','rw','bars','Rework by defect category','Rework lines per category'],
    ['rw2','rw','bars','Replacement by defect category','Replacement lines per category'],
    ['rw3','rw','month','Month by month','Items per month by result, whole year'],
    ['rw4','rw','pareto','Rework causes, biggest first','Pareto: share and running total'],
    ['rw5','rw','bars','Rework by process code','Every process code, ranked'],
    ['rw6','rw','bars','Rework by operator','Every operator, ranked']
  ].map(([key,grp,kind,title,desc])=>({key,grp,kind,title,desc}));
  const thumb=k=>'<svg viewBox="0 0 64 48" width="64" height="48" aria-hidden="true">'+(
    k==='bars'?'<g fill="currentColor"><rect x="10" y="9" width="44" height="6" rx="3"/><rect x="10" y="21" width="32" height="6" rx="3"/><rect x="10" y="33" width="20" height="6" rx="3"/></g>'
    :k==='pareto'?'<g fill="currentColor"><rect x="9" y="14" width="9" height="28" rx="2"/><rect x="21" y="25" width="9" height="17" rx="2"/><rect x="33" y="32" width="9" height="10" rx="2"/><rect x="45" y="37" width="9" height="5" rx="2"/></g><polyline points="13,14 25,10 37,7 49,6" fill="none" stroke="#eb6834" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>'
    :'<g fill="currentColor"><rect x="8" y="26" width="7" height="16" rx="2"/><rect x="18" y="18" width="7" height="24" rx="2"/><rect x="28" y="22" width="7" height="20" rx="2"/><rect x="38" y="12" width="7" height="30" rx="2"/><rect x="48" y="20" width="7" height="22" rx="2"/></g>')+'</svg>';
  const drawer=$('#fullScrim'),sel=new Set();let tab='ca',fmt='pdf',ori='portrait';
  const lock=on=>{document.documentElement.style.overflow=on?'hidden':'';document.body.style.overflow=on?'hidden':''};   // the page behind must not scroll while the panel is open
  const inTab=g=>UI.filter(p=>p.grp===g);
  const count=g=>inTab(g).filter(p=>sel.has(p.key)).length;
  const paint=()=>{
    $$('.fd-tab',drawer).forEach(t=>t.classList.toggle('on',t.dataset.tab===tab));
    $('#fdBadgeCA').textContent=count('ca');$('#fdBadgeRW').textContent=count('rw');
    const mine=inTab(tab),n=count(tab);
    $('#fdTabInfo').textContent=n+' of '+mine.length+' chosen';
    $('#fdAllTab').textContent=n===mine.length?'Clear this tab':'Select all in this tab';
    $('#fdList').innerHTML=mine.map(p=>`<button type="button" class="fd-card${sel.has(p.key)?' on':''}" data-key="${p.key}" aria-pressed="${sel.has(p.key)}"><span class="fd-th">${thumb(p.kind)}</span><span class="fd-tx"><b>${p.title}</b><small>${p.desc}</small></span><span class="fd-ck">✓</span></button>`).join('');
    $$('.fd-card',drawer).forEach(c=>c.onclick=()=>{sel.has(c.dataset.key)?sel.delete(c.dataset.key):sel.add(c.dataset.key);paint()});
    const t=sel.size;
    $('#fdSum').innerHTML=t?`<b>${t} part${t===1?'':'s'} selected</b><br>Concession Accept ${count('ca')} · Rework ${count('rw')}`:'Nothing selected yet. Tap a card to add it.';
    $('#fdGo').disabled=!t;$('#fdGo').textContent='Download '+fmt.toUpperCase();
    $$('.fd-fmt',drawer).forEach(b=>b.classList.toggle('on',b.dataset.fmt===fmt));
    $$('.fd-ori',drawer).forEach(b=>b.classList.toggle('on',b.dataset.ori===ori));
    $('#fdOrient').hidden=fmt!=='pdf';   // page direction only matters for the PDF
  };
  const shut=()=>{drawer.classList.remove('on');drawer.setAttribute('aria-hidden','true');lock(false)};
  $('#expFullBtn').onclick=()=>{close();sel.clear();tab='ca';paint();drawer.classList.add('on');drawer.setAttribute('aria-hidden','false');lock(true);$('#fdList').scrollTop=0};
  $$('.fd-tab',drawer).forEach(t=>t.onclick=()=>{tab=t.dataset.tab;paint();$('#fdList').scrollTop=0});
  $$('.fd-fmt',drawer).forEach(b=>b.onclick=()=>{fmt=b.dataset.fmt;paint()});
  $$('.fd-ori',drawer).forEach(b=>b.onclick=()=>{ori=b.dataset.ori;paint()});
  $('#fdAllTab').onclick=()=>{const mine=inTab(tab),all=count(tab)===mine.length;mine.forEach(p=>all?sel.delete(p.key):sel.add(p.key));paint()};
  $('#fdClose').onclick=shut;
  drawer.addEventListener('click',e=>{if(e.target===drawer)shut()});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&drawer.classList.contains('on'))shut()});
  $('#fdGo').onclick=()=>{
    const parts=expFullParts().filter(p=>sel.has(p.key));shut();
    if(parts.length)fmt==='pdf'?exportFullPDF(parts,ori):exportPPTX(parts);
  };
}

function init(){
  setupConfirmDialog();
  setupPromptDialog();
  setupLogin();
  setupShell();
  setupSearchBoxes();

  // Wire up every page's buttons/tabs/switches immediately, regardless of
  // login/backend state. This is what makes the bulk/single upload switch
  // (and every other button) clickable even before a real session exists —
  // previously this only ran after a successful login, so if the backend
  // wasn't reachable yet, nothing on Upload/Records/Reports/Settings worked.
  setupDashboard();
  setupUploadPage();
  setupRecordsPage();
  setupRework();
  setupExport();
  setupSettingsPage();
  hydrateIcons();

  checkSession().then(async()=>{
    const rawName=(location.hash||'#/login').slice(2).split('?')[0].split('/')[0];
    const publicPages=['login',''];
    if(AUTH.authenticated&&publicPages.includes(rawName)){
      location.hash=homeHash();
    }else if(!AUTH.authenticated&&!publicPages.includes(rawName)){
      location.hash='#/login';
    }

    if(AUTH.authenticated){
      appBooted=true;
      applyUser(AUTH.user);
      try{await refreshLiveContent()}catch(e){console.error(e)}
    }

    window.addEventListener('hashchange',route);
    route();
    if(AUTH.authenticated)annPopupMaybe();
  });
}

init();
</script>

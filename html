function deptCan(key,action,u){
  u=u||AUTH.user;const d=DEPTS[key];if(!u||!d)return false;
  if(isOwnerUser(u))return true;
  const inside=inDept(u,d.dept);
  if(action==='edit')return inside&&d.editRoles.includes(u.role);
  return inside||u.role==='admin';                       // view
}

/* extra fields (type, event date, auto-disappear) travel inside the message as a small header, so the existing server needs no change */
/* Short header at the start of the message, e.g. "[i261107T1400x261030]" = incoming on 07 Nov 2026 14:00, disappears after 30 Oct 2026.
   (i = incoming date yymmdd with optional Thhmm, x = last day shown yymmdd.) About 20 characters, hidden everywhere it is shown. */
const ANN_HDR=/^\s*\[(?:i(\d{6})(?:T(\d{4}))?)?(?:x(\d{6}))?\]\s*/;
const ANN_OLD=/^\s*\[\[meta:([\s\S]*?)\]\]\s*/;       // older posts used a longer JSON header; still understood
const annYmd=v=>'20'+v.slice(0,2)+'-'+v.slice(2,4)+'-'+v.slice(4,6);
function annPack(body,m){
  let h='';
  if(m.k==='incoming'&&m.d){const q=String(m.d).split('T');h+='i'+q[0].replace(/-/g,'').slice(2)+(q[1]?'T'+q[1].replace(':',''):'')}
  if(m.x)h+='x'+String(m.x).replace(/-/g,'').slice(2);
  return h?'['+h+']\n'+body:body;
}
function annParse(a){
  const o=Object.assign({},a),raw=String(a.body||'');let m={},mm;
  if((mm=raw.match(ANN_HDR))&&mm[0].trim().length>2){
    if(mm[1]){m.k='incoming';m.d=annYmd(mm[1])+(mm[2]?'T'+mm[2].slice(0,2)+':'+mm[2].slice(2):'')}
    if(mm[3])m.x=annYmd(mm[3]);
    o.body=raw.slice(mm[0].length);
  }else if((mm=raw.match(ANN_OLD))){
    try{m=JSON.parse(mm[1].replace(/&quot;/g,'"').replace(/&amp;/g,'&'))||{}}catch(e){m={}}
    o.body=raw.slice(mm[0].length);
  }
  o.kind=m.k==='incoming'?'incoming':'announcement';
  o.eventAt=m.d?annLocal(m.d):null;o.hasTime=!!(m.d&&String(m.d).length>10);
  o.expiresAt=m.x?annLocal(m.x+'T23:59:59'):null;
  return o;
}
function annLocal(v){const d=new Date(String(v).replace(' ','T'));return isNaN(d)?null:d}
const annExpired=a=>!!(a.expiresAt&&a.expiresAt<new Date());
function annDaysTo(d){const t=new Date();t.setHours(0,0,0,0);const e=new Date(d);e.setHours(0,0,0,0);return Math.round((e-t)/864e5)}
function annCountdown(a){if(!a.eventAt)return '';const n=annDaysTo(a.eventAt);return n<0?'Happened':n===0?'Today':n===1?'Tomorrow':'In '+n+' days'}
function annEventText(a){if(!a.eventAt)return '';return a.eventAt.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long'})+(a.hasTime?' · '+a.eventAt.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}):'')}
function annInitials(n){return String(n||'?').trim().split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase()}
function annHtml(a,canDelete,opts={}){
  const inc=a.kind==='incoming'&&a.eventAt,gone=annExpired(a),n=inc?annDaysTo(a.eventAt):0;
  const icon=inc?`<span class="annic"><b>${String(a.eventAt.getDate()).padStart(2,'0')}</b><i>${a.eventAt.toLocaleDateString('en-GB',{month:'short'}).toUpperCase()}</i></span>`:`<span class="annic"><svg class="ic"><use href="#i-megaphone"/></svg></span>`;
  const typeB=inc?'<span class="annbadge inc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>Incoming</span>':'<span class="annbadge ann"><svg class="ic"><use href="#i-megaphone"/></svg>Announcement</span>';
  const tags=typeB+(inc?`<span class="anninc${n>=0&&n<=2?' soon':''}">${esc(annCountdown(a))}</span>`:(opts.feat?'<span class="annlatest">Latest</span>':''))+(annIsNew(a.created_at)?'<span class="annnew">New</span>':'')+(gone?'<span class="annexp">Expired</span>':'');
  return `<article class="anncard${opts.feat?' feat':''}${inc?' inc':''}${gone?' gone':''}" style="--i:${opts.i||0}">${icon}<div class="annmain"><div class="annmeta">${tags}<span class="annwho"><span class="annav">${esc(annInitials(a.created_by_name))}</span>${esc(a.created_by_name||'')}</span><span class="anndot"></span><time title="${esc(annDate(a.created_at))}">${esc(annAgo(a.created_at))}</time></div><h3>${esc(a.title)}</h3>${inc?`<p class="anndue">${esc(annEventText(a))}</p>`:''}<p>${esc(a.body)}</p>${canDelete?`<button type="button" class="btn secondary danger" data-anndel="${a.id}">Delete</button>`:''}</div></article>`;

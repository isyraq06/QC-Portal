      toast(`Split into ${data.created} record${data.created===1?'':'s'}`);
      goTo(RECORDS.some(x=>x.needsReview)?'#/records?review=1':'#/records');
    }catch(err){
      console.error(err);
      toast(err.message,{type:'error'});
      $('#sSave').disabled=false;
    }
  };
}

function setupRecordEdit(r){
  if(r.needsReview)setupSplit(r);
  const card=$('#editCard');
  $('#editBtn').onclick=()=>{
    const sp=$('#splitCard');
    if(sp&&!sp.hidden){sp.hidden=true;card.hidden=false;return}
    card.hidden=!card.hidden;
    if(!card.hidden)card.scrollIntoView({behavior:'smooth',block:'center'});
  };
  $('#eCancel').onclick=()=>{if(r.needsReview)goTo('#/records');else card.hidden=true};
  $('#eSave').onclick=async()=>{
    const body={id:r.id,wo_no:$('#eWo').value.trim(),so_no:$('#eSo').value.trim(),spec:$('#eSpec').value.trim(),
      material:$('#eMat').value.trim(),qty_check:+$('#eQc').value||0,qty_detect:+$('#eQd').value||0,status:$('#eStatus').value,notes:$('#eNotes').value.trim()};
    if(r.needsReview&&!body.wo_no){toast('Enter the WO no. to finish the review',{type:'error'});return}
    $('#eSave').disabled=true;
    try{
      const res=await fetch(API_BASE+'record_update.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      const data=await res.json();
      if(!res.ok||!data.success)throw new Error(data.error||'Save failed');
      const chg=histChanged([['WO no.',r.wo,body.wo_no],['S/Order no.',r.so,body.so_no],['Specification',r.spec,body.spec],['Material',r.material,body.material],['Qty check',r.qtyCheck,body.qty_check],['Qty detect',r.qtyDetect,body.qty_detect],['Status',r.status,body.status],['Notes',r.notes,body.notes]]);
      await logEvent('record',r.id,'edited',chg);
      await refreshLiveContent();
      toast('Record saved');
      const n=RECORDS.find(x=>String(x.id)===String(r.id));
      const key=n?recKey(n):'';
      goTo('#/record/'+key);
      renderRecordPage(key);
    }catch(err){
      console.error(err);
      toast(err.message,{type:'error'});
      $('#eSave').disabled=false;
    }
  };
}

function setupFlagButton(r){
  const btn=$('#flagBtn');
  if(!btn)return;
  btn.onclick=async()=>{
    const next=!r.needsReview;
    if(next){
      const ok=await askConfirm({
        title:'Flag this record for review?',
        message:'WO '+r.wo+' will show the purple "Needs review" tag on Inspection Records and count on the Dashboard, until someone unflags it.',
        confirmLabel:'Flag it',
        danger:false
      });
      if(!ok)return;
    }
    btn.disabled=true;
    try{
      const res=await fetch(API_BASE+'record_flag.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:r.id,needs_review:next})});
      const data=await res.json();
      if(!res.ok||!data.success)throw new Error(data.error||'Could not update the flag');
      await logEvent('record',r.id,next?'flagged':'unflagged');
      await refreshLiveContent();
      toast(next?'Flagged for review':'Review flag removed');
      renderRecordPage(recKey({...r,needsReview:next}));
    }catch(err){
      toast(err.message,{type:'error'});
      btn.disabled=false;
    }
  };
}

function setupDeleteButton(r){
  const btn=$('#deleteBtn');
  if(!btn)return; // only shown to admins
  btn.onclick=async()=>{
    const docs=docsOfRecord(r);
    const extra=docs.length?` ${docs.length} attached document${docs.length===1?'':'s'} will stay in Reports but will no longer show on this record.`:'';
    const ok=await askConfirm({
      title:'Delete this record?',
      message:`${r.needsReview?'This needs-review row':'WO '+r.wo} moves to Settings → Trash, and is hidden from records and search until restored.${extra}`,
      confirmLabel:'Delete'
    });
    if(!ok)return;
    btn.disabled=true;btn.textContent='Deleting…';
    try{
      await authApi('record_delete.php',{id:r.id});
      await logEvent('record',r.id,'deleted');
      await refreshLiveContent();
      toast('Record deleted');
      goTo('#/records');
    }catch(err){
      toast(err.message,{type:'error'});
      btn.disabled=false;btn.innerHTML=icon('trash')+'Delete record';
      hydrateIcons();
    }
  };
}


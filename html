async function confirmBulkImport(){
  const toImport=bulkParsedRows.filter(r=>!isBulkDuplicate(r));
  if(!toImport.length){toast('Nothing new to import',{type:'error'});return}

  const ok=await askConfirm({title:'Import these records?',message:`Import ${toImport.length} new record${toImport.length===1?'':'s'} from “${bulkFile?bulkFile.name:'this file'}” into Concession accept? Only this file is imported; the next file (if any) will ask again.`,confirmLabel:'Import this file',danger:false});
  if(!ok)return;
  const batchNote=$('#bulkNote').value.trim();
  $('#bulkConfirm').disabled=true;
  $('#bulkConfirm').textContent='Importing…';
  try{
    const res=await fetch(API_BASE+'records_bulk_import.php',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({records:toImport.map(r=>({...r,notes:[batchNote,r.rowNote||''].filter(Boolean).join(' — '),rowNote:undefined}))})
    });
    const data=await res.json();
    if(!res.ok||!data.success)throw new Error(data.error||'Import failed');

    // Keep the original Excel file too, so it shows up in Recent uploads and Reports (View / Download work on it)
    let fileMsg='';
    if(data.inserted>0&&bulkFile){
      try{
        const fd=new FormData();
        fd.append('csrf',AUTH.csrf);fd.append('batch','1');fd.append('doc_type','Imported Excel');
        fd.append('uploaded_date',todayISO());
        fd.append('notes',[`Bulk import: ${data.inserted} record${data.inserted===1?'':'s'}`+(data.flagged?` (${data.flagged} need review)`:''),batchNote].filter(Boolean).join(' — ').slice(0,500));
        fd.append('files[]',bulkFile,bulkFile.name);
        const dres=await fetch(API_BASE+'document_create.php',{method:'POST',credentials:'same-origin',body:fd});
        let dd={};try{dd=await dres.json()}catch(e){}
        if(!dres.ok||!dd.success)throw new Error(dd.error||'upload failed');
      }catch(err){
        console.error(err);
        fileMsg=`The records were imported, but the Excel file itself couldn't be saved: ${err.message}`;
      }
    }

    await refreshLiveContent();

    toast(`${data.inserted} record${data.inserted===1?'':'s'} imported`+(data.flagged?` (${data.flagged} need review)`:''));
    if(fileMsg)toast(fileMsg,{type:'error'});
    bulkQ.finish('done');
  }catch(err){
    console.error(err);
    toast('Import failed: '+err.message,{type:'error'});
  }finally{
    $('#bulkConfirm').disabled=false;
    $('#bulkConfirm').innerHTML='<i data-i="upload"></i>Import records';
    hydrateIcons();
  }
}


/* =========================================================
   DEPARTMENTS: one entry per department. Everything else (menus, the home boxes, page guards,
   "view only" messages) reads from this list. To add a department, add an entry here, its sidebar
   group (id = groupSel) and its pages; nothing else in the code needs changing.
   Rules, the same for every department:
     - the owner can do everything
     - people IN the department can view; their role must be in editRoles to edit
     - an administrator from ANOTHER department can only view (clicking anything that changes data shows a red message at the top right)
     - everyone else has no access
   The PHP server must enforce the same rules; `api` lists the server files that change this department's data.
   ========================================================= */
const DEPTS={
  qc:{key:'qc',dept:'Quality Control',title:'QC Department',ic:'qc',c1:'#047857',c2:'#10B981',groupSel:'#grpQC',
    pages:['dashboard','records','record','upload','reports','qcassess'],editRoles:['admin','staff'],editors:'Quality Control team members',
    api:/^(record|records|rework|document|material|defect_category|restore|purge)[_.]?(?!.*(list|file|events|get))/,
    items:[{h:'#/dashboard',t:'QC Dashboard',c1:'#1D4ED8',c2:'#3B82F6'},{h:'#/records',t:'Inspection Records',c1:'#0F766E',c2:'#0D9488'},{h:'#/upload',t:'Upload',c1:'#B93C0B',c2:'#D9480F'},{h:'#/reports',t:'Reports',c1:'#A21CAF',c2:'#C026D3'}]},
  prod:{key:'prod',dept:'Production',title:'Production Department',ic:'prod',c1:'#5B21B6',c2:'#6366F1',groupSel:'#grpPROD',
    pages:['pworkers','passess','passessform'],editRoles:['admin'],editors:'Production administrators',
    api:/^production_.*save/,
    items:[{h:'#/pworkers',t:'Workers',c1:'#0369A1',c2:'#0EA5E9'},{h:'#/passess',t:'Assessments',c1:'#BE185D',c2:'#EC4899'}]}
};
const deptList=()=>Object.values(DEPTS);

    try{
      const wb=XLSX.read(e.target.result,{type:'array'});
      clearKindWarning('rwBulk');
      if(!force){
        const kind=detectExcelKind(wb);
        if(kind!=='rework'){
          rwBulkRows=[];$('#rwBulkPreviewCard').hidden=true;$('#rwBulkStatus').textContent='';
          showKindWarning('rwBulk',kind,file,f=>rwHandleBulkFile(f,true),f=>{
            const sw=$('[data-switch="upload"] button[data-v="ca"]');if(sw)sw.click();
            const md=$('#upModeSeg button[data-mode="bulk"]')||$$('.upmode:not(#rwUpModeSeg) button[data-mode="bulk"]')[0];if(md)md.click();
            bulkQ.add([f]);            // joins the Concession accept queue and waits for its own review and confirmation
            rwBulkQ.finish('moved');
          });
          return;
        }
      }
      const {records,errors,sheets}=rwExtract(wb);
      rwBulkRows=records;rwRenderBulkPreview(errors,sheets);
    }catch(err){console.error(err);$('#rwBulkStatus').textContent='Could not read that file. Is it a valid .xls/.xlsx?'}

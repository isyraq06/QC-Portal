  const m_tr=sx+arc/2,m_br=sx+arc+sy+arc/2,m_bl=sx+arc+sy+arc+sx+arc/2,m_tl=L-arc/2;
  const S=[...fan(m_tr,92,9,25,0),...fan(m_tr,92,8,25,1),...fan(m_bl,72,7,19,0),...fan(m_bl,72,6,19,1),
          ...fan(m_tl,40,4,13,0),...fan(m_br,40,4,13,0)];
  const kite=({s,len},i)=>{const p=at(s),w=(1.2+len*.2).toFixed(2),L2=len.toFixed(1),mid=(len*.34).toFixed(1),f=['a','b','a','c'][i%4];

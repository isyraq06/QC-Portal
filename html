  rework:[0,5,10,20,30],
  drawing:[4.5,4,3.5,3,2.5,2,1.5,1,0],
  skill:[4.5,4,3.5,3,2.5,2,1.5,1,0],
  cooperation:[2,1.5,1,0],
  obey:[2,1.5,1,0],
  rules:[1,0],
  colleagues:[1,0],
  maintenance:[5,4,3,2,1,0],

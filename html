const CROP_V=280;          // size of the crop box on screen
let crop=null;             // {img,url,min,scale,ox,oy}
function cropClamp(){
  const c=crop,w=c.img.width*c.scale,h=c.img.height*c.scale;
  c.ox=Math.min(0,Math.max(CROP_V-w,c.ox));
  c.oy=Math.min(0,Math.max(CROP_V-h,c.oy));
}
function cropDraw(){
  const cv=$('#cropCanvas'),ctx=cv.getContext('2d'),c=crop,dpr=window.devicePixelRatio||1;
  if(cv.width!==Math.round(CROP_V*dpr)){cv.width=cv.height=Math.round(CROP_V*dpr)}
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.fillStyle='#fff';ctx.fillRect(0,0,CROP_V,CROP_V);
  ctx.drawImage(c.img,c.ox,c.oy,c.img.width*c.scale,c.img.height*c.scale);
}
function cropSetZoom(z){          // z = 1..4 times the smallest size that still fills the box
  const c=crop,cx=(CROP_V/2-c.ox)/c.scale,cy=(CROP_V/2-c.oy)/c.scale;
  c.scale=c.min*z;c.ox=CROP_V/2-cx*c.scale;c.oy=CROP_V/2-cy*c.scale;
  cropClamp();cropDraw();
}
function openCrop(file){
  const url=URL.createObjectURL(file),img=new Image();
  img.onload=()=>{
    let src=img;
    if(Math.max(img.width,img.height)>1600){     // shrink huge phone photos so dragging stays smooth
      const k=1600/Math.max(img.width,img.height),t=document.createElement('canvas');
      t.width=Math.round(img.width*k);t.height=Math.round(img.height*k);
      t.getContext('2d').drawImage(img,0,0,t.width,t.height);src=t;
    }
    const min=CROP_V/Math.min(src.width,src.height);
    crop={img:src,url,min,scale:min,ox:(CROP_V-src.width*min)/2,oy:(CROP_V-src.height*min)/2};
    $('#cropZoom').value=1;cropDraw();openScrim('#cropScrim');
  };
  img.onerror=()=>{URL.revokeObjectURL(url);toast("That picture couldn't be read. Try a JPG or PNG.",{type:'error'})};
  img.src=url;
}
function closeCrop(){
  closeScrim('#cropScrim');
  if(crop){URL.revokeObjectURL(crop.url);crop=null}
}
function cropExport(size=512){
  const c=crop,k=size/CROP_V,cv=document.createElement('canvas');
  cv.width=cv.height=size;
  const ctx=cv.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,size,size);
  ctx.drawImage(c.img,c.ox*k,c.oy*k,c.img.width*c.scale*k,c.img.height*c.scale*k);
  return cv.toDataURL('image/jpeg',0.86);
}


let dashPeriod='';   // '' = all time, otherwise 'YYYY-MM'
const monthLabel=m=>new Date(m+'-02').toLocaleDateString('en-GB',{month:'long',year:'numeric'});
const inDashPeriod=r=>!dashPeriod||r.date.slice(0,7)===dashPeriod;

function renderDashPeriod(){
  const months=[...new Set(RECORDS.map(r=>r.date.slice(0,7)))].sort().reverse();
  if(dashPeriod&&!months.includes(dashPeriod))dashPeriod='';
  $('#dashPeriod').innerHTML='<option value="">All time</option>'+months.map(m=>`<option value="${m}"${m===dashPeriod?' selected':''}>${monthLabel(m)}</option>`).join('');
}

function tallyDefects(){
  const counts={};
  DEFECT_CATEGORIES.forEach(c=>counts[c]=0);
  RECORDS.filter(r=>inDashPeriod(r)&&!r.needsReview).forEach(r=>Object.keys(r.defects).forEach(c=>{counts[c]=(counts[c]||0)+1}));
  return Object.entries(counts).filter(([,n])=>n>0).sort((a,b)=>b[1]-a[1]);
}

function renderDashStats(){
  const scope=RECORDS.filter(inDashPeriod);                 // chosen month, or everything
  const normal=scope.filter(r=>!r.needsReview);            // flagged rows are left out of the numbers
  const review=scope.length-normal.length;
  const periodText=dashPeriod?monthLabel(dashPeriod):'All time';
  const mq=dashPeriod?'&month='+dashPeriod:'';
  const note=review?`<span class="n-note" title="Not counted: ${review} record(s) need review">+${review} need review</span>`:'';
  $('#dashStats').innerHTML=`
    <a class="card stat" href="#/records${dashPeriod?'?month='+dashPeriod:''}"><div class="top">Total records<span class="dot-ic"><i data-i="items"></i></span></div><div class="n">${normal.length}${note}</div><small>${periodText}${review?', excluding needs review':''}</small></a>
    <a class="card stat review-stat${review?'':' zero'}" href="#/records?review=1${mq}"><div class="top">Needs review<span class="dot-ic"><i data-i="edit"></i></span></div><div class="n">${review}</div><small>${review?'Click to see and fix them':(dashPeriod?'Nothing to fix this month':'Nothing to fix')}</small></a>`;
  hydrateIcons($('#dashStats'));
}

function renderDefectBars(){
  const tally=tallyDefects().slice(0,5);
  const max=tally.length?tally[0][1]:1;
  $('#defectBars').innerHTML=tally.length
    ?tally.map(([cat,n])=>`<div class="barrow"><div class="lbl">${cat}</div><div class="track"><div class="fill" style="width:${Math.round(n/max*100)}%"></div></div><div class="val">${n}</div></div>`).join('')
    :`<p style="color:var(--muted)">No defects logged${dashPeriod?' in this month':' yet'}.</p>`;
}

/* =========================================================
   Dashboard insights (administrators and the Owner only).
   Plain SVG, calculated in the page from the records that are already loaded: nothing is saved anywhere,
   and the charts redraw by themselves whenever the data is reloaded (import, add, edit, delete).
   ========================================================= */
const vzAdmin=()=>!!(AUTH.user&&AUTH.user.role==='admin');
const VZ_MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const vzNum=n=>Number(n).toLocaleString('en-GB');
const vzPct=(a,b)=>b?(a/b*100).toFixed(2):'0.00';   // always 2 decimals, e.g. 89.01
const vzTrunc=(s,n)=>{s=String(s);return s.length>n?s.slice(0,Math.max(1,n-1))+'…':s};
/* nice axis: 4 equal steps (1, 2 or 5 times a power of ten) */
function vzAxis(max){
  const raw=Math.max(max,1)/4,p=Math.pow(10,Math.floor(Math.log10(raw))),f=raw/p;
  const step=(f<=1?1:f<=2?2:f<=5?5:10)*p;
  return {step,max:step*4,ticks:[0,1,2,3,4].map(i=>i*step)};
}
const vzTipAttr=(head,rows)=>`data-tip="${encodeURIComponent(JSON.stringify({head,rows}))}"`;
/* a bar whose top (data end) is rounded 4px and whose base is square */
const vzTopRound=(x,y,w,h,r=4)=>{r=Math.min(r,w/2,h);return `M${x},${y+h}V${y+r}Q${x},${y} ${x+r},${y}H${x+w-r}Q${x+w},${y} ${x+w},${y+r}V${y+h}Z`};
const vzRightRound=(x,y,w,h,r=4)=>{r=Math.min(r,h/2,w);return `M${x},${y}H${x+w-r}Q${x+w},${y} ${x+w},${y+r}V${y+h-r}Q${x+w},${y+h} ${x+w-r},${y+h}H${x}Z`};

/* ---- tooltip (one shared element; text is always inserted with textContent) ---- */
function vzTipShow(el,x,y){
  let d;try{d=JSON.parse(decodeURIComponent(el.getAttribute('data-tip')))}catch(e){return}
  let tip=document.getElementById('vzTip');
  if(!tip){tip=document.createElement('div');tip.id='vzTip';tip.className='vz-tip';tip.setAttribute('role','tooltip');document.body.appendChild(tip)}
  tip.textContent='';
  const h=document.createElement('div');h.className='h';h.textContent=d.head;tip.appendChild(h);
  d.rows.forEach(r=>{
    const row=document.createElement('div');row.className='r';
    const k=document.createElement('i');k.className='k';if(r.c)k.style.borderTopColor=r.c;row.appendChild(k);
    const l=document.createElement('span');l.textContent=r.l;row.appendChild(l);
    const v=document.createElement('b');v.textContent=r.v;row.appendChild(v);
    tip.appendChild(row);
  });
  tip.hidden=false;
  const w=tip.offsetWidth,hh=tip.offsetHeight;
  tip.style.left=Math.max(8,Math.min(x+14,innerWidth-w-8))+'px';
  tip.style.top=Math.max(8,Math.min(y+14,innerHeight-hh-8))+'px';
}
const vzTipHide=()=>{const t=document.getElementById('vzTip');if(t)t.hidden=true};
function vzBindOnce(){
  if(window.__vzBound)return;window.__vzBound=true;
  document.addEventListener('pointermove',e=>{const el=e.target.closest&&e.target.closest('[data-tip]');el?vzTipShow(el,e.clientX,e.clientY):vzTipHide()});
  document.addEventListener('focusin',e=>{const el=e.target.closest&&e.target.closest('[data-tip]');if(el){const r=el.getBoundingClientRect();vzTipShow(el,r.left+r.width/2,r.top)}});
  document.addEventListener('focusout',vzTipHide);
  document.addEventListener('scroll',vzTipHide,true);
  document.addEventListener('click',e=>{
    const b=e.target.closest&&e.target.closest('[data-vz-table]');if(!b)return;
    const card=b.closest('.vz-card'),show=card.querySelector('.vz-tbl').hidden;
    card.querySelector('.vz-tbl').hidden=!show;card.querySelector('.vz-body').hidden=show;
    b.textContent=show?'Chart':'Table';
  });
}

/* ---- small building blocks ---- */
function vzTable(head,rows){
  return `<table class="t"><thead><tr>${head.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
}
function vzCard(title,sub,legend,body,tableHTML){
  return `<div class="card vz-card"><div class="ch"><div><h2>${esc(title)}</h2>${sub?`<small>${esc(sub)}</small>`:''}</div><button type="button" class="btn ghost sm" data-vz-table>Table</button></div>
    <div class="cb"><div class="vz-body">${legend||''}<div class="vz">${body}</div></div><div class="vz-tbl" hidden>${tableHTML}</div></div></div>`;
}
const vzTile=(label,value,sub,txt)=>`<div class="card vz-tile"><div class="l">${esc(label)}</div><div class="v${txt?' txt':''}">${esc(value)}</div><div class="s">${esc(sub)}</div></div>`;
const vzLegendSw=s=>`<span><i class="vz-sw" style="background:${s.color}" aria-hidden="true">${s.glyph}</i>${esc(s.label)}</span>`;

/* ---- stacked columns: one column per month, January to December ---- */
function vzMonthly(w,series,data,year){
  const H=250,m={t:16,r:10,b:30,l:40},iw=Math.max(200,w-m.l-m.r),ih=H-m.t-m.b;
  const tot=data.map(d=>series.reduce((s,x)=>s+(d[x.key]||0),0));
  if(!tot.some(Boolean))return `<div class="vz-empty">Nothing recorded in ${year} yet.</div>`;
  const ax=vzAxis(Math.max(...tot)),slot=iw/12,bw=Math.min(24,slot*.62),Y=v=>m.t+ih-v/ax.max*ih;
  const maxI=tot.indexOf(Math.max(...tot));
  let g=`<svg viewBox="0 0 ${w} ${H}" role="img" aria-label="Records per month in ${year}, stacked by result">`;
  ax.ticks.forEach(t=>{g+=`<line class="grid" x1="${m.l}" x2="${w-m.r}" y1="${Y(t)}" y2="${Y(t)}"/><text x="${m.l-8}" y="${Y(t)+4}" text-anchor="end">${vzNum(t)}</text>`});
  data.forEach((d,i)=>{
    const cx=m.l+slot*i+slot/2,x=cx-bw/2;let base=0;
    const live=series.filter(s=>(d[s.key]||0)>0);
    live.forEach((s,j)=>{
      const v=d[s.key],h=v/ax.max*ih,top=Y(base+v),isTop=j===live.length-1,gap=j>0?2:0,hh=Math.max(1,h-gap);
      g+=isTop?`<path d="${vzTopRound(x,top,bw,hh)}" style="fill:${s.color}"/>`:`<rect x="${x}" y="${top}" width="${bw}" height="${hh}" style="fill:${s.color}"/>`;
      base+=v;
    });
    if(i===maxI)g+=`<text class="ink b" x="${cx}" y="${Y(tot[i])-6}" text-anchor="middle">${vzNum(tot[i])}</text>`;
    g+=`<text x="${cx}" y="${H-10}" text-anchor="middle">${VZ_MON[i]}</text>`;
    const rows=tot[i]?series.map(s=>({c:s.color,l:s.label,v:vzNum(d[s.key]||0)})).concat([{c:'transparent',l:'Total',v:vzNum(tot[i])}]):[{c:'transparent',l:'Nothing recorded',v:'0'}];
    g+=`<rect class="hit" tabindex="0" x="${m.l+slot*i}" y="${m.t}" width="${slot}" height="${ih+16}" ${vzTipAttr(VZ_MON[i]+' '+year,rows)} aria-label="${VZ_MON[i]} ${year}: ${tot[i]} in total"/>`;
  });
  return g+`</svg>`;
}

/* ---- Pareto: bars = each item's share of the total, line = running total. One axis: % of the total. ---- */
function vzPareto(w,items,unit,opt){
  opt=opt||{};   // opt.total / opt.cum0: used by the Full record when a long list is split over several pages
  const total=opt.total||items.reduce((s,x)=>s+x.n,0);
  if(!total)return `<div class="vz-empty">Nothing to show for this period.</div>`;
  const rowH=34,top=26,labW=opt.labW||Math.min(190,Math.round(w*.36)),gut=44,x0=labW+10,x1=w-gut,H=top+items.length*rowH+8;
  const X=p=>x0+p/100*(x1-x0);
  let g=`<svg viewBox="0 0 ${w} ${H}" role="img" aria-label="Pareto chart: share and running total of ${unit}">`;
  [0,25,50,75,100].forEach(p=>{g+=`<line class="grid" x1="${X(p)}" x2="${X(p)}" y1="${top-6}" y2="${H-8}"/><text x="${X(p)}" y="12" text-anchor="${p===0?'start':p===100?'end':'middle'}">${p}%</text>`});
  let cum=opt.cum0||0;const pts=[];
  items.forEach((it,i)=>{
    const share=it.n/total*100;cum+=share;const cy=top+i*rowH+rowH/2,bh=14,bw=Math.max(2,X(share)-x0);
    g+=`<text class="ink" x="${opt.left?0:labW}" y="${cy+4}" text-anchor="${opt.left?'start':'end'}">${esc(vzTrunc(it.name,Math.floor(labW/6.4)))}</text>`;
    g+=`<path d="${vzRightRound(x0,cy-bh/2,bw,bh)}" style="fill:var(--accent)"/>`;
    g+=`<text class="ink b" x="${w}" y="${cy+4}" text-anchor="end">${vzNum(it.n)}</text>`;
    pts.push([X(Math.min(cum,100)),cy,cum,it,share]);
  });
  g+=`<polyline points="${[[X(Math.min(opt.cum0||0,100)),top].join(',')].concat(pts.map(p=>p[0]+','+p[1])).join(' ')}" fill="none" style="stroke:var(--vz-2)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`;
  pts.forEach(p=>{g+=`<circle cx="${p[0]}" cy="${p[1]}" r="4" style="fill:var(--vz-2);stroke:var(--card)" stroke-width="2"/>`});
  pts.forEach((p,i)=>{
    g+=`<rect class="hit" tabindex="0" x="0" y="${top+i*rowH}" width="${w}" height="${rowH}" ${vzTipAttr(p[3].name,[{c:'var(--accent)',l:'Count',v:vzNum(p[3].n)},{c:'var(--accent)',l:'Share of total',v:p[4].toFixed(2)+'%'},{c:'var(--vz-2)',l:'Running total',v:Math.min(p[2],100).toFixed(2)+'%'}])} aria-label="${esc(p[3].name)}: ${p[3].n}, running total ${Math.round(p[2])}%"/>`;
  });
  return g+`</svg>`;
}

/* ---- ranked horizontal bars (top N) ---- */
function vzHBars(w,items,unit,opt){
  if(!items.length)return `<div class="vz-empty">Nothing to show for this period.</div>`;
  const rowH=32,labW=(opt&&opt.labW)||Math.min(190,Math.round(w*.36)),gut=40,x0=labW+10,x1=w-gut,H=items.length*rowH+8,max=(opt&&opt.max)||items[0].n;
  let g=`<svg viewBox="0 0 ${w} ${H}" role="img" aria-label="${esc(unit)}">`;
  items.forEach((it,i)=>{
    const cy=i*rowH+rowH/2+2,bw=Math.max(2,it.n/max*(x1-x0));
    g+=`<text class="ink" x="${opt&&opt.left?0:labW}" y="${cy+4}" text-anchor="${opt&&opt.left?'start':'end'}">${esc(vzTrunc(it.name,Math.floor(labW/6.4)))}</text>`;
    g+=`<path d="${vzRightRound(x0,cy-7,bw,14)}" style="fill:var(--accent)"/>`;
    g+=`<text class="ink b" x="${x0+bw+8}" y="${cy+4}">${vzNum(it.n)}</text>`;
    g+=`<rect class="hit" tabindex="0" x="0" y="${i*rowH+2}" width="${w}" height="${rowH}" ${vzTipAttr(it.name,[{c:'var(--accent)',l:unit,v:vzNum(it.n)}])} aria-label="${esc(it.name)}: ${it.n}"/>`;
  });
  return g+`</svg>`;
}

/* ---- data helpers ---- */
function vzTop(map,n){
  const all=[...map.entries()].map(([name,c])=>({name,n:c})).sort((a,b)=>b.n-a.n||a.name.localeCompare(b.name));
  return {top:all.slice(0,n),rest:all.slice(n)};
}
function vzParetoItems(map,n=8){
  const {top,rest}=vzTop(map,n),other=rest.reduce((s,x)=>s+x.n,0);
  return other?top.concat([{name:`Other (${rest.length})`,n:other}]):top;
}
const vzParetoLegend=`<div class="vz-legend"><span><i class="vz-sw" style="background:var(--accent)"></i>Share of total</span><span><i class="vz-ln"></i>Running total</span></div>`;
const vzPeriodSub=(p,fallback)=>p?monthLabel(p):fallback;

/* ---- CA ---- */
function vzBuildCA(w){
  const wi=i=>Array.isArray(w)?w[i]:w;   /* each chart is drawn at its own card's real width (in page order) */
  const normal=RECORDS.filter(r=>!r.needsReview),scope=normal.filter(inDashPeriod),n=scope.length;
  const checked=scope.reduce((s,r)=>s+(+r.qtyCheck||0),0),det=scope.reduce((s,r)=>s+(+r.qtyDetect||0),0);
  const tally=tallyDefects(),topDef=tally[0];
  const tiles=[
    vzTile('Defect rate (pieces)',checked?vzPct(det,checked)+'%':'—',checked?`${vzNum(det)} of ${vzNum(checked)} pieces checked`:'No pieces checked'),
    vzTile('Most common defect',topDef?topDef[0]:'—',topDef?`${vzNum(topDef[1])} record${topDef[1]===1?'':'s'}`:'No defects logged',true)
  ].join('');
  const dm=new Map(tally.map(([k,c])=>[k,c])),pItems=vzParetoItems(dm),ptotal=pItems.reduce((s,x)=>s+x.n,0);
  let run=0;const ptab=vzTable(['Defect','Records','Share','Running total'],pItems.map(x=>{run+=x.n;return [x.name,x.n,vzPct(x.n,ptotal)+'%',vzPct(run,ptotal)+'%']}));
  const by=(f)=>{const m=new Map();scope.forEach(r=>{const k=String(f(r)||'').trim();if(k)m.set(k,(m.get(k)||0)+1)});return m};
  const mat=vzTop(by(r=>r.material),8),ins=vzTop(by(r=>r.by),8);
  const tabOf=(t,h)=>vzTable([h,'Records'],t.top.map(x=>[x.name,x.n]));
  const per=vzPeriodSub(dashPeriod,'All time');
  const cards=[
    vzCard('Defects, biggest first',`${per}. Records per defect type, with the running total.`,vzParetoLegend,vzPareto(wi(0),pItems,'records'),ptab),
    vzCard('Records by material',`${per}. Top ${mat.top.length}${mat.rest.length?`, ${mat.rest.length} more not shown`:''}.`,'',vzHBars(wi(1),mat.top,'Records'),tabOf(mat,'Material')),
    vzCard('Records by accepted-by',`${per}. Who handled the records, top ${ins.top.length}.`,'',vzHBars(wi(2),ins.top,'Records'),tabOf(ins,'Accepted by'))
  ].join('');
  return `<div class="vz-head"><h3>Insights</h3><span class="tag">Administrators and Owner only</span></div><div class="vz-tiles">${tiles}</div><div class="vz-grid">${cards}</div>`;
}

/* ---- Rework ---- */
function vzBuildRW(w){
  const wi=i=>Array.isArray(w)?w[i]:w;   /* each chart is drawn at its own card's real width (in page order) */
  const normal=RW.filter(r=>!r.needsReview),scope=normal.filter(rwInPeriod);
  const group=(lines)=>{const m=new Map();lines.forEach(r=>{const k=r.ref||('id'+r.id);let it=m.get(k);if(!it){it={ref:r.ref,date:r.date,result:r.result,lines:[]};m.set(k,it)}if(!it.result&&r.result)it.result=r.result;it.lines.push(r)});return [...m.values()]};
  const items=group(scope),n=items.length,cnt=k=>items.filter(i=>i.result===k).length;
  const passed=cnt('passed'),conc=cnt('concession');
  const rwItems=items.filter(i=>i.lines.some(rwHasRework)).length;
  const qty=scope.reduce((s,r)=>s+(r.rwQty||0),0);
  let qtySub=`${vzNum(scope.filter(rwHasRework).length)} rework lines`;
  if(rwDashPeriod){
    const [y,mo]=rwDashPeriod.split('-').map(Number),pd=new Date(y,mo-2,1),pk=pd.getFullYear()+'-'+String(pd.getMonth()+1).padStart(2,'0');
    const prev=normal.filter(r=>(r.date||'').slice(0,7)===pk).reduce((s,r)=>s+(r.rwQty||0),0);
    if(RW.some(r=>(r.date||'').slice(0,7)===pk)){const d=qty-prev;qtySub=(d===0?'Same as ':(d>0?'▲ '+vzNum(d)+' more than ':'▼ '+vzNum(-d)+' fewer than '))+VZ_MON[pd.getMonth()]}
  }
  const tiles=[
    vzTile('First-pass yield',n?vzPct(passed,n)+'%':'—',n?`${vzNum(passed)} of ${vzNum(n)} items passed (counted by Ref No)`:'No records in this period'),
    vzTile('Concession rate',n?vzPct(conc,n)+'%':'—',n?`${vzNum(conc)} of ${vzNum(n)} items`:'No records in this period'),

// Hold-to-show eye on password boxes: the text is visible only while the eye is pressed.
function addEyes(ids){
  ids.forEach(id=>{
    const inp=document.getElementById(id);
    if(!inp||inp.parentElement.classList.contains('pwwrap'))return;
    const wrap=document.createElement('div');wrap.className='pwwrap';
    inp.parentNode.insertBefore(wrap,inp);wrap.appendChild(inp);
    const b=document.createElement('button');
    b.type='button';b.className='eye';b.setAttribute('aria-label','Hold to show password');b.title='Hold to show';
    b.innerHTML=icon('eye');
    const show=()=>{inp.type='text';b.classList.add('on')};
    const hide=()=>{inp.type='password';b.classList.remove('on')};
    b.addEventListener('mousedown',e=>e.preventDefault());
    b.addEventListener('pointerdown',e=>{e.preventDefault();show()});
    ['pointerup','pointerleave','pointercancel','blur','keyup'].forEach(t=>b.addEventListener(t,hide));
    b.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter'){e.preventDefault();show()}});
    b.addEventListener('contextmenu',e=>e.preventDefault());
    wrap.appendChild(b);
  });
}


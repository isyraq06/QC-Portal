function evExport(onlyId){
  try{
    const bytes=EvalCore.buildWorkbook(evShown(),EV.evals,EV.year,onlyId?{only:onlyId}:{});
    const blob=new Blob([bytes],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    const w=onlyId?EV.workers.find(x=>String(x.id)===String(onlyId)):null;
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);

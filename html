    else{y=Math.random()*h;x=Math.random()<.5?-pad*Math.random():w+pad*Math.random()}          // left or right edge
    const sz=3+Math.random()*8;
    e.style.cssText=`left:${x}px;top:${y}px;width:${sz}px;height:${sz}px;--sx:${(Math.random()*30-15).toFixed(0)}px;--rise:${(26+Math.random()*44).toFixed(0)}px;animation-duration:${(.9+Math.random()*.9).toFixed(2)}s`;
    layer.appendChild(e);e.onanimationend=()=>e.remove();
  };
  const start=()=>{if(t)return;for(let i=0;i<5;i++)spawn();t=setInterval(()=>{spawn();if(Math.random()<.6)spawn()},95)};
  const stop=()=>{clearInterval(t);t=null};
  box.addEventListener('pointerenter',start);box.addEventListener('pointerleave',stop);
  box.addEventListener('focus',start);box.addEventListener('blur',stop);
  box.addEventListener('click',stop);
}


/* ---------- History tab ----------
   A tiny log kept by the server (record_events): who did what and when (real date + time).
   Only the newest 30 events per record are kept and no copies of the data are stored. */
const HIST_ACTIONS={edited:'Edited',uploaded:'Document uploaded',flagged:'Flagged for review',unflagged:'Review flag removed',deleted:'Deleted (moved to Trash)',restored:'Restored from Trash',doc_edited:'Document note edited',doc_removed:'Document removed'};
async function logEvent(kind,id,action,detail){
  try{await authApi('record_events.php',{kind,id,action,detail:String(detail||'').slice(0,160)})}
  catch(e){console.warn('History line was not saved:',e.message)}
}
const histTime=t=>{const m=/^(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d)/.exec(t||'');return m?`${+m[3]} ${VZ_MON[+m[2]-1]} ${m[1]}, ${m[4]}:${m[5]}`:(t||'')};
/* names of the fields that differ: pairs are [label, before, after] */
const histChanged=pairs=>pairs.filter(([,a,b])=>String(a==null?'':a).trim()!==String(b==null?'':b).trim()).map(x=>x[0]).join(', ');
function histListHTML(base,events,docs){
  const have=events.filter(e=>e.action==='uploaded').map(e=>e.detail||'').join('\n');
  const rows=events.map(e=>[HIST_ACTIONS[e.action]||e.action,e.detail,histTime(e.at),e.actor]);
  /* documents added before the log existed still show, with their date only */
  docs.filter(d=>!have.includes(d.f)).forEach(d=>rows.push(['Document uploaded',d.f,formatDate(d.date),d.by]));
  base.forEach(b=>rows.push([b[0],'',b[1],b[2]]));
  return rows.map(h=>`<li class="done"><b>${esc(h[0])}${h[1]?': '+esc(h[1]):''}</b><small>${esc(h[2])}${h[3]?' · '+esc(h[3]):''}</small></li>`).join('');
}
async function loadHistory(kind,id,ulSel,base,docs){

    if(s<sx)return {x:r+s,y:0,a:0};s-=sx;
    if(s<arc)return arcPt(W-r,r,s/arc*90);s-=arc;
    if(s<sy)return {x:W,y:r+s,a:90};s-=sy;
    if(s<arc)return arcPt(W-r,H-r,90+s/arc*90);s-=arc;
    if(s<sx)return {x:W-r-s,y:H,a:180};s-=sx;
    if(s<arc)return arcPt(r,H-r,180+s/arc*90);s-=arc;
    if(s<sy)return {x:0,y:H-r-s,a:270};s-=sy;
    return arcPt(r,r,270+s/arc*90);};

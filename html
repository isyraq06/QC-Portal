function todayISO(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}

function fillRecForm(){
  const mat=$('#nrMat');
  if(!mat)return;
  const cur=mat.value;
  mat.innerHTML='<option value="">Select material</option>'+MATERIALS.map(m=>`<option value="${esc(m)}"${m===cur?' selected':''}>${esc(m)}</option>`).join('');
  const box=$('#nrDefects');
  if(box.dataset.n!==String(DEFECT_CATEGORIES.length)){
    box.dataset.n=DEFECT_CATEGORIES.length;
    box.innerHTML=DEFECT_CATEGORIES.length
      ?DEFECT_CATEGORIES.map(c=>`<div class="nrdef"><label><input type="checkbox" class="nrChk" data-cat="${esc(c)}"> ${esc(c)}</label><input class="inp nrNote" placeholder="Note (optional)" disabled></div>`).join('')
      :'<p class="hint">No defect categories loaded yet.</p>';
    $$('.nrChk',box).forEach(ch=>ch.onchange=()=>{const n=ch.closest('.nrdef').querySelector('.nrNote');n.disabled=!ch.checked;if(ch.checked)n.focus();else n.value=''});
  }
  if(!$('#nrDate').value)$('#nrDate').value=todayISO();
}

function clearRecForm(){
  ['#nrWo','#nrSo','#nrSpec','#nrBy'].forEach(id=>$(id).value='');
  $('#nrNotes').value='';
  $('#nrMat').value='';$('#nrStatus').value='released';$('#nrQc').value='0';$('#nrQd').value='0';$('#nrDate').value=todayISO();
  $$('#nrDefects .nrChk').forEach(ch=>{ch.checked=false});
  $$('#nrDefects .nrNote').forEach(n=>{n.value='';n.disabled=true});
}

async function saveNewRecord(){
  const wo=$('#nrWo').value.trim();
  if(!wo){toast('Enter the WO no. first',{type:'error'});return}
  if(RECORDS.some(x=>x.wo===wo)){toast('WO '+wo+' already exists. Open it from Inspection Records.',{type:'error'});return}
  const date=$('#nrDate').value;
  if(!date){toast('Choose the inspection date',{type:'error'});return}
  const ok=await askConfirm({title:'Add this record?',message:`Add WO ${wo} to the inspection records?`,confirmLabel:'Add records',danger:false});
  if(!ok)return;
  const defects={};
  $$('#nrDefects .nrdef').forEach(d=>{
    const ch=d.querySelector('.nrChk');
    if(ch&&ch.checked)defects[ch.dataset.cat]=d.querySelector('.nrNote').value.trim();
  });
  const body={wo_no:wo,so_no:$('#nrSo').value.trim(),spec:$('#nrSpec').value.trim(),material:$('#nrMat').value,
    qty_check:+$('#nrQc').value||0,qty_detect:+$('#nrQd').value||0,status:$('#nrStatus').value,
    inspected_by:$('#nrBy').value.trim(),inspection_date:date,defects,notes:$('#nrNotes').value.trim()};
  $('#nrGo').disabled=true;
  try{
    const res=await fetch(API_BASE+'record_create.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const data=await res.json();
    if(!res.ok||!data.success)throw new Error(data.error||'Could not save the record');
    await refreshLiveContent();
    clearRecForm();
    toast('Record added');
    goTo('#/record/'+encodeURIComponent(wo));
  }catch(err){
    console.error(err);
    toast(err.message,{type:'error'});
  }finally{
    $('#nrGo').disabled=false;
  }
}

function setupUploadPage(){
  $$('#upModeSeg button').forEach(b=>b.onclick=()=>{
    $$('#upModeSeg button').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-selected',x===b)});
    $$('[data-up-panel]').forEach(p=>p.hidden=p.dataset.upPanel!==b.dataset.mode);
    if(b.dataset.mode==='record')fillRecForm();
  });

  $('#nrGo').onclick=saveNewRecord;
  $('#nrClear').onclick=clearRecForm;
  fillRecForm();

  bulkQ=makeUploadQueue({key:'bulk',label:'Concession accept',header:'WO NO',load:handleBulkFile,reset:resetBulkUI});
  bulkQ.bindInput('bulkDrop','bulkFileIn');

  $('#bulkCancel').onclick=()=>bulkQ.skip();
  $('#bulkConfirm').onclick=confirmBulkImport;
}

/* =========================================================
   Bulk Excel import — reads the real Conditioning Release
   Report layout: one sheet per month, 2-row header, data
   starting a couple rows below, fixed 21-column layout.
   ========================================================= */
const DEFECT_COLS=[
  {idx:8,cat:'Appearance'},{idx:9,cat:'D1'},{idx:10,cat:'P'},{idx:11,cat:'ID'},
  {idx:12,cat:'Short'},{idx:13,cat:'Long'},{idx:14,cat:'Small'},{idx:15,cat:'Big'},
  {idx:16,cat:'Inner L'},{idx:17,cat:'Other'},{idx:18,cat:'Angle'},{idx:19,cat:'Screw/Thread'}
];

let bulkParsedRows=[];
let bulkFile=null;   // the original Excel file, kept so it can be saved with the import

function parseDateCell(v){
  if(v==null||v==='')return null;
  if(v instanceof Date) return v.toISOString().slice(0,10);
  const s=String(v).trim();
  const m=s.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/); // DD.MM.YYYY as used in the real sheet
  if(m) return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
  const asNum=Number(s);
  if(!isNaN(asNum)&&asNum>20000&&asNum<60000){ // fallback: Excel serial date
    const d=XLSX.SSF.parse_date_code(asNum);
    if(d) return `${d.y}-${String(d.m).padStart(2,'0')}-${String(d.d).padStart(2,'0')}`;
  }
  return null;
}
function isBulkDuplicate(r){
  if(r.needs_review){
    return RECORDS.some(x=>x.needsReview&&x.so===r.so_no&&x.date===r.inspection_date);
  }
  return RECORDS.some(x=>x.wo===r.wo_no);
}
function cleanId(v){
  if(v==null)return '';
  return String(v).trim().replace(/\.0$/,'');
}

function extractRecordsFromWorkbook(wb){
  const out=[];
  const errors=[];
  wb.SheetNames.forEach(sheetName=>{
    const sheet=wb.Sheets[sheetName];
    const rows=XLSX.utils.sheet_to_json(sheet,{header:1,defval:null});

    // Find the header row by locating "WO NO" in column index 3
    let headerRow=-1;
    for(let i=0;i<rows.length;i++){
      const cell=rows[i]&&rows[i][3];
      if(cell&&String(cell).trim().toUpperCase()==='WO NO'){headerRow=i;break}
    }
    if(headerRow===-1){errors.push(`${sheetName}: couldn't find the header row, skipped`);return}

    let lastDate=null;
    // Every order in this sheet -> its "/66" ending and material (taken from the normal item rows)
    const orderMap={};
    for(let i=headerRow+2;i<rows.length;i++){
      const rw=rows[i]||[];
      if(rw.every(c=>c==null||String(c).trim()===''))break;
      const oi=orderInfo(cleanId(rw[2]));
      if(cleanId(rw[3])&&oi&&oi.suffix){
        const m=rw[7]!=null?String(rw[7]).trim():'';
        const cur=orderMap[oi.prefix];
        if(!cur||(!cur.material&&m))orderMap[oi.prefix]={suffix:oi.suffix,material:m};
      }
    }
    let lastPrefix=null;   // the order of the row above (item row OR group row): group rows without their own order use it
    for(let i=headerRow+2;i<rows.length;i++){
      const row=rows[i]||[];
      const allBlank=row.every(c=>c==null||String(c).trim()==='');
      if(allBlank)break; // end of this sheet's data

      const soNo=cleanId(row[2]);
      const woNo=cleanId(row[3]);
      if(!woNo&&!soNo)continue; // stray blank row, keep scanning

      const dateVal=parseDateCell(row[1]);
      if(dateVal)lastDate=dateVal;

      const defects={};
      DEFECT_COLS.forEach(d=>{
        const v=row[d.idx];
        if(v!=null&&String(v).trim()!=='')defects[d.cat]=String(v).trim();
      });

      let soFinal=soNo;
      let matFinal=row[7]!=null?String(row[7]).trim():'';
      if(woNo){
        const oi=orderInfo(soNo);
        if(oi)lastPrefix=oi.prefix;
      }else{
        // group row like "*18, 14, 10" / "10, 13, 14" / "SO2605-0053-26, 20"
        const g=soNo.replace(/^[\s*＊•]+/,'').replace(/[\s,，]+$/,'');
        const wp=g.match(/^(.*-)(\d+(?:\s*[,，]\s*\d+)*)$/);
        let prefix=null,list=null;
        if(/^\d+(\s*[,，]\s*\d+)*$/.test(g)){ if(lastPrefix){prefix=lastPrefix;list=g} }
        else if(wp){prefix=wp[1];list=wp[2]}
        if(prefix){
          const ref=orderMap[prefix];
          soFinal=prefix+list+(ref?ref.suffix:'');
          if(!matFinal&&ref)matFinal=ref.material;
          lastPrefix=prefix;
        }
      }

      out.push({
        month:sheetName,
        wo_no:woNo,
        needs_review:!woNo,
        so_no:soFinal,
        spec:row[4]!=null?String(row[4]).trim():'',
        qty_check:parseInt(row[5])||0,
        qty_detect:parseInt(row[6])||0,
        material:matFinal,
        status:'released', // this report only logs rejects that were accepted/released by PROD/Sales
        inspected_by:row[20]!=null?String(row[20]).trim():'',
        inspection_date:lastDate,
        defects
      });
    }
  });
  return {records:out,errors};
}

/* =========================================================
   Wrong-file guard for the two Excel uploads (Concession accept vs Rework).
   Easy comparison on the header row:
     Concession accept report  ->  has a "WO NO" column
     Rework listing            ->  has a "Ref No" column (+ Checking Result / Rework… / Replacement…)
   If the file looks like the OTHER type, nothing is read or imported: the user gets a warning block that explains
   the difference and offers to move the file to the right upload, read it here anyway, or cancel.
   ========================================================= */
function detectExcelKind(wb){
  let wo=false,ref=false;
  wb.SheetNames.forEach(name=>{
    const rows=XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,defval:'',raw:true,blankrows:false}).slice(0,15);
    rows.forEach(r=>r.forEach(c=>{
      const t=String(c==null?'':c).replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim().toUpperCase();
      if(t==='WO NO'||t==='WO NO.')wo=true;
      if(/^REF\.? ?NO$/.test(t)||t==='CHECKING RESULT'||t.startsWith('REWORK PROCESS'))ref=true;
    }));
  });
  if(ref&&!wo)return 'rework';
  if(wo&&!ref)return 'concession';
  return 'unknown';
}
const KIND_LABEL={concession:'Concession accept',rework:'Rework'};
const KIND_HEAD={concession:'WO NO',rework:'Ref No'};
function clearKindWarning(target){const el=document.getElementById(target+'KindWarn');if(el)el.remove()}
function showKindWarning(target,found,file,onForce,onMove){
  // target: 'bulk' (Concession accept page) or 'rwBulk' (Rework page)
  const expected=target==='bulk'?'concession':'rework';
  const other=expected==='concession'?'rework':'concession';
  clearKindWarning(target);
  const status=document.getElementById(target+'Status');
  const box=document.createElement('div');
  box.id=target+'KindWarn';
  box.className='warn-note kind-warn';
  box.setAttribute('role','alert');
  box.style.cssText='flex-direction:column;gap:12px;padding:16px 18px;margin:14px 0 0;font-weight:500';
  const title=found==='unknown'
    ? `We couldn't tell what kind of file “${esc(file.name)}” is`
    : `“${esc(file.name)}” looks like a ${KIND_LABEL[found]} file, not a ${KIND_LABEL[expected]} file`;
  const why=found==='unknown'
    ? `A ${KIND_LABEL[expected]} file should have a <b>${KIND_HEAD[expected]}</b> column in its header row, and we couldn't find it.`
    : `This file has a <b>${KIND_HEAD[found]}</b> column. ${KIND_LABEL[expected]} files have <b>${KIND_HEAD[expected]}</b> instead.`;
  box.innerHTML=`
    <div style="font-size:15px;font-weight:800">⚠ Check before uploading: ${title}</div>
    <div>${why}</div>
    <table style="border-collapse:collapse;font-size:13px;background:rgba(255,255,255,.55);border-radius:8px;overflow:hidden">
      <tr><th style="text-align:left;padding:6px 12px">Upload type</th><th style="text-align:left;padding:6px 12px">Look for this column</th><th style="text-align:left;padding:6px 12px">This file</th></tr>
      <tr><td style="padding:6px 12px">Concession accept</td><td style="padding:6px 12px"><b>WO NO</b></td><td style="padding:6px 12px">${found==='concession'?'✔ found':'✘ not found'}</td></tr>
      <tr><td style="padding:6px 12px">Rework</td><td style="padding:6px 12px"><b>Ref No</b> (+ Checking Result, Rework …)</td><td style="padding:6px 12px">${found==='rework'?'✔ found':'✘ not found'}</td></tr>
    </table>
    <div>Nothing has been uploaded. ${found==='unknown'?'Check that you picked the right file':'Uploading it in the wrong place would put the records in the wrong category'}. You can:</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      ${found==='unknown'?'':`<button type="button" class="btn primary sm" data-kw="move">Move it to the ${KIND_LABEL[other]} upload</button>`}
      <button type="button" class="btn secondary sm" data-kw="force">I'm sure, read it here anyway</button>
      <button type="button" class="btn ghost sm" data-kw="cancel">Cancel</button>
    </div>`;
  status.insertAdjacentElement('afterend',box);
  $('[data-kw="force"]',box).onclick=()=>{clearKindWarning(target);onForce(file)};
  $('[data-kw="cancel"]',box).onclick=()=>{clearKindWarning(target);target==='bulk'?bulkQ.skip():rwBulkQ.skip()};
  const mv=$('[data-kw="move"]',box);
  if(mv)mv.onclick=()=>{clearKindWarning(target);onMove(file)};
  box.scrollIntoView({behavior:'smooth',block:'nearest'});
}

/* =========================================================
   Multi-file upload queue (up to 12 files) for both Excel uploads.
   Files are reviewed and imported ONE AT A TIME: each file gets its own preview and its own
   Import confirmation. Nothing is imported until the user confirms that specific file.
   ========================================================= */
const UPLOAD_MAX_FILES=12;
const fmtFileSize=n=>n>=1048576?(n/1048576).toFixed(1)+' MB':Math.max(1,Math.round(n/1024))+' KB';
function makeUploadQueue(cfg){
  const q={items:[],cur:-1,info:null,other:null};
  const host=()=>{
    let el=document.getElementById(cfg.key+'Queue');
    if(!el){el=document.createElement('div');el.id=cfg.key+'Queue';el.className='upq';el.hidden=true;document.getElementById(cfg.key+'Status').insertAdjacentElement('beforebegin',el)}
    return el;
  };
  const card=()=>document.getElementById(cfg.key+'PreviewCard');
  const infoEl=()=>{
    let el=document.getElementById(cfg.key+'FileInfo');
    if(!el){el=document.createElement('div');el.id=cfg.key+'FileInfo';el.className='fileinfo';card().querySelector('.cb').prepend(el)}
    return el;
  };
  q.add=function(fileList){
    const incoming=[...fileList];
    if(!incoming.length)return;
    const ok=incoming.filter(f=>/\.(xlsx|xls)$/i.test(f.name));
    if(ok.length<incoming.length)toast(`${incoming.length-ok.length} file${incoming.length-ok.length===1?' was':'s were'} ignored: only .xls / .xlsx files can be uploaded here.`,{type:'error'});
    if(q.items.length&&q.items.every(i=>i.status!=='waiting'&&i.status!=='current'))q.items=[],q.cur=-1; // previous batch is finished: start fresh
    const room=UPLOAD_MAX_FILES-q.items.length;
    if(ok.length>room)toast(`You can upload up to ${UPLOAD_MAX_FILES} files at once. ${room>0?'Only the first '+room+' were added.':'Finish the current files first.'}`,{type:'error'});
    ok.slice(0,Math.max(0,room)).forEach(f=>q.items.push({file:f,status:'waiting'}));
    if(q.cur<0)q.next();else q.render();
  };
  q.next=function(){
    const i=q.items.findIndex(x=>x.status==='waiting');
    q.cur=i;
    q.info=null;
    if(i<0){q.render();return}
    q.items[i].status='current';
    q.render();
    cfg.load(q.items[i].file,false);
  };
  /* result: done | skipped | moved | error. Clears the current file's preview and moves on to the next waiting file. */
  q.finish=function(result){
    if(q.cur>=0&&q.items[q.cur])q.items[q.cur].status=result;
    cfg.reset();
    q.next();
  };
  q.skip=function(){q.finish('skipped')};
  q.remove=function(i){if(q.items[i]&&q.items[i].status==='waiting'){q.items.splice(i,1);if(q.cur>i)q.cur--;q.render()}};
  q.current=()=>q.cur>=0?q.items[q.cur]:null;
  /* Called by the preview once the file has been read: shows what the user is about to import. */
  q.setInfo=function(i){
    q.info=i;
    const it=q.current();if(!it)return;
    const pos=q.cur+1,total=q.items.length;
    infoEl().innerHTML=`<div class="t">📄 ${esc(it.file.name)}</div>
      <div>File ${pos} of ${total} · ${fmtFileSize(it.file.size)} · ${i.sheets} sheet${i.sheets===1?'':'s'} · ${i.rows} row${i.rows===1?'':'s'} read</div>
      <div>Detected as: <b>${cfg.label} file</b> (has a <b>${cfg.header}</b> column)</div>
      <div>Importing it adds <b>${i.fresh} new record${i.fresh===1?'':'s'}</b> to <b>${cfg.label}</b>${i.dup?` and skips <b>${i.dup}</b> that already exist`:''}. Only this file will be imported. Confirm each file one by one.</div>`;
  };
  q.render=function(){
    const el=host();
    if(!q.items.length){el.hidden=true;el.innerHTML='';return}
    el.hidden=false;
    const label={waiting:'Waiting',current:'Reviewing now',done:'✓ Imported',skipped:'Skipped',moved:'Moved',error:'Not read'};
    const finished=q.items.every(i=>i.status!=='waiting'&&i.status!=='current');
    const n=k=>q.items.filter(i=>i.status===k).length;
    el.innerHTML=`<div class="qh">${finished
        ?`<b>All ${q.items.length} file${q.items.length===1?'':'s'} reviewed.</b> ${n('done')} imported${n('skipped')?`, ${n('skipped')} skipped`:''}${n('moved')?`, ${n('moved')} moved to the other upload`:''}. Drop more files to start again.`
        :`<b>${q.items.length} file${q.items.length===1?'':'s'} selected</b> (up to ${UPLOAD_MAX_FILES}). They are reviewed <b>one at a time</b>: nothing is imported until you click Import on the file being reviewed.`}</div>`
      +q.items.map((it,i)=>`<div class="qr${it.status==='current'?' cur':''}"><span class="qn">${i+1}</span><span class="qf" title="${esc(it.file.name)}">${esc(it.file.name)}</span><span class="qs">${fmtFileSize(it.file.size)}</span>
        <span class="qc ${it.status==='current'?'cur':(it.status==='done'?'done':(it.status==='moved'?'moved':''))}">${label[it.status]}</span>
        ${it.status==='waiting'?`<button type="button" class="link qx" data-qrm="${i}">Remove</button>`:''}
        ${it.status==='current'?`<button type="button" class="link qx" data-qskip="1">Skip this file</button>`:''}</div>`).join('');
    $$('[data-qrm]',el).forEach(b=>b.onclick=()=>q.remove(+b.dataset.qrm));
    $$('[data-qskip]',el).forEach(b=>b.onclick=()=>q.skip());
    const cardEl=card();
    if(cardEl){const h=cardEl.querySelector('.ch h2');const it=q.current();if(h)h.textContent=it?`Preview · file ${q.cur+1} of ${q.items.length}`:'Preview'}
  };
  q.bindInput=function(dropId,inputId){
    const drop=document.getElementById(dropId),input=document.getElementById(inputId);
    input.multiple=true;
    ['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('over')}));
    ['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('over')}));
    drop.addEventListener('drop',e=>{q.add(e.dataTransfer.files)});
    input.onchange=e=>{q.add(e.target.files);e.target.value=''};
  };
  return q;
}
let bulkQ=null,rwBulkQ=null;

function handleBulkFile(file,force){
  bulkFile=file;
  $('#bulkStatus').textContent='Reading '+file.name+'…';
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'array'});
      clearKindWarning('bulk');
      if(!force){
        const kind=detectExcelKind(wb);
        if(kind!=='concession'){
          bulkParsedRows=[];$('#bulkPreviewCard').hidden=true;$('#bulkStatus').textContent='';
          showKindWarning('bulk',kind,file,f=>handleBulkFile(f,true),f=>{
            const sw=$('[data-switch="upload"] button[data-v="rework"]');if(sw)sw.click();
            const md=$('#rwUpModeSeg button[data-mode="bulk"]');if(md)md.click();
            rwBulkQ.add([f]);          // joins the Rework queue and waits for its own review and confirmation
            bulkQ.finish('moved');
          });
          return;
        }
      }
      const {records,errors}=extractRecordsFromWorkbook(wb);
      bulkParsedRows=records;
      if(errors.length)console.warn('Bulk import warnings:',errors);
      renderBulkPreview(records,errors,wb.SheetNames.length);
    }catch(err){
      console.error(err);
      $('#bulkStatus').textContent='Could not read that file — is it a valid .xls/.xlsx?';
    }
  };
  reader.readAsArrayBuffer(file);
}

function renderBulkPreview(records,errors,sheetCount){
  $('#bulkStatus').textContent=errors&&errors.length?errors.join(' · '):'';
  if(!records.length){
    $('#bulkPreviewCard').hidden=true;
    $('#bulkStatus').textContent='No rows found in that file.';
    return;
  }
  const dupCount=records.filter(isBulkDuplicate).length;
  const reviewCount=records.filter(r=>r.needs_review&&!isBulkDuplicate(r)).length;

  $('#bulkSummary').innerHTML=`
    <div class="stat"><b>${sheetCount}</b><small>sheets read</small></div>
    <div class="stat"><b>${records.length}</b><small>rows found</small></div>
    <div class="stat"><b>${records.length-dupCount}</b><small>new records</small></div>
    <div class="stat"><b>${dupCount}</b><small>already in database (skipped)</small></div>
    <div class="stat"><b>${reviewCount}</b><small>need review (no WO no.)</small></div>`;

  $('#bulkPreviewBody').innerHTML=records.map((r,i)=>{
    const isDup=isBulkDuplicate(r);
    const defectsStr=Object.keys(r.defects).join(', ')||'—';
    return `<tr class="${isDup?'dup':(r.needs_review?'review':'')}">
      <td>${esc(r.month)}</td><td>${esc(r.inspection_date||'—')}</td>
      <td>${esc(r.so_no)}</td><td>${esc(r.wo_no)}${isDup?' <span class="bulk-dup-tag">duplicate</span>':''}${(!isDup&&r.needs_review)?' <span class="bulk-review-tag">needs review</span>':''}</td>
      <td>${esc(r.material)}</td><td>${r.qty_check}</td><td>${r.qty_detect}</td>
      <td>${esc(defectsStr)}</td><td>${esc(r.inspected_by)}</td>
      <td>${isDup?'<span class="muted">—</span>':`<input class="inp bulkRowNote" data-i="${i}" maxlength="40" placeholder="short note" style="min-width:150px;height:30px;font-size:12.5px;padding:0 8px">`}</td>
    </tr>`;
  }).join('');

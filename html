const DOC_MAX_BYTES=20*1024*1024;                       // keep in sync with api/document_create.php
const DOC_INLINE=['pdf','jpg','jpeg','png','gif','webp','txt'];
const docUrl=(id,dl)=>API_BASE+'document_file.php?id='+encodeURIComponent(id)+(dl?'&download=1':'');

const DOC_SHEET=['xlsx','xls','xlsm','csv'];
const SHEET_MAX_ROWS=3000;
/* View an Excel / CSV file: the browser cannot show these itself, so the file is read here (SheetJS) and shown as a
   read-only table in a new tab. Nothing is changed or saved. */
async function openSheetViewer(d){
  const w=window.open('','_blank');
  if(!w){toast('The new tab was blocked. Allow pop-ups for this site and try again.',{type:'error'});return}
  const E=x=>String(x==null?'':x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const shell=(body,extra='')=>{w.document.open();w.document.write(`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${E(d.f||'Spreadsheet')}</title>
<style>
:root{color-scheme:light dark;--bg:#f4f8fa;--card:#fff;--ink:#0e2333;--muted:#4c6c84;--line:#dae4ea;--head:#eaf1f5;--accent:#0b5d8f}
@media(prefers-color-scheme:dark){:root{--bg:#0d1b26;--card:#132736;--ink:#e8f1f6;--muted:#9bb4c4;--line:#27425a;--head:#1b3447;--accent:#6bb7e6}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{position:sticky;top:0;z-index:5;background:var(--card);border-bottom:1px solid var(--line);padding:12px 18px;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center}
h1{font-size:16px;margin:0;word-break:break-all}.sub{color:var(--muted);font-size:12.5px}
.sp{flex:1}a.btn,button.btn{font:inherit;font-weight:600;color:var(--accent);background:transparent;border:1px solid var(--line);border-radius:8px;padding:6px 12px;text-decoration:none;cursor:pointer}
a.btn:hover,button.btn:hover{border-color:var(--accent)}
nav{display:flex;gap:6px;flex-wrap:wrap;padding:10px 18px 0}
nav button{font:inherit;font-size:13px;border:1px solid var(--line);border-bottom:0;background:var(--head);color:var(--muted);padding:7px 14px;border-radius:8px 8px 0 0;cursor:pointer}
nav button[aria-selected="true"]{background:var(--card);color:var(--ink);font-weight:700}
main{padding:0 18px 24px}.pane{background:var(--card);border:1px solid var(--line);border-radius:0 10px 10px 10px;overflow:auto;max-height:calc(100vh - 150px)}
table{border-collapse:separate;border-spacing:0;font-size:13px;min-width:100%}
th,td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:6px 10px;white-space:nowrap;text-align:left;vertical-align:top;max-width:380px;overflow:hidden;text-overflow:ellipsis}
thead th{position:sticky;top:0;background:var(--head);color:var(--muted);font-weight:700;z-index:2}
th.rn,td.rn{position:sticky;left:0;background:var(--head);color:var(--muted);text-align:right;font-variant-numeric:tabular-nums;z-index:1}
thead th.rn{z-index:3}
.note{padding:14px 18px;color:var(--muted)}.err{padding:40px 18px;text-align:center}
</style></head><body>${body}${extra}</body></html>`);w.document.close()};
  shell(`<div class="err">Opening ${E(d.f||'file')}…</div>`);
  try{
    const res=await fetch(docUrl(d.id,true),{credentials:'same-origin'});
    if(!res.ok)throw new Error(res.status===404?'The saved file could not be found on the server.':'The file could not be loaded ('+res.status+').');
    const buf=await res.arrayBuffer();
    const wb=XLSX.read(buf,{type:'array',cellDates:false});
    const sheets=wb.SheetNames.map(n=>{
      const ws=wb.Sheets[n];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:'',blankrows:true});
      let last=rows.length;while(last>0&&rows[last-1].every(c=>c===''))last--;   // trailing empty rows
      const used=rows.slice(0,last);
      const cols=used.reduce((m,r)=>Math.max(m,r.length),0);
      return {name:n,rows:used.slice(0,SHEET_MAX_ROWS),total:used.length,cols};
    });
    const colName=i=>{let s='',n=i+1;while(n>0){const m=(n-1)%26;s=String.fromCharCode(65+m)+s;n=Math.floor((n-1)/26)}return s};
    const tab=(sh,i)=>{
      if(!sh.total)return `<div class="pane" id="p${i}" ${i?'hidden':''}><div class="note">This sheet is empty.</div></div>`;
      const head='<tr><th class="rn"></th>'+Array.from({length:sh.cols},(_,c)=>`<th>${colName(c)}</th>`).join('')+'</tr>';
      const body=sh.rows.map((r,ri)=>`<tr><td class="rn">${ri+1}</td>`+Array.from({length:sh.cols},(_,c)=>`<td title="${E(r[c])}">${E(r[c])}</td>`).join('')+'</tr>').join('');
      const cut=sh.total>sh.rows.length?`<div class="note">Showing the first ${sh.rows.length.toLocaleString()} of ${sh.total.toLocaleString()} rows. Download the file to see everything.</div>`:'';
      return `<div class="pane" id="p${i}" ${i?'hidden':''}><table><thead>${head}</thead><tbody>${body}</tbody></table>${cut}</div>`;
    };
    const blobUrl=URL.createObjectURL(new Blob([buf]));
    const nav=sheets.length>1?`<nav role="tablist">${sheets.map((sh,i)=>`<button role="tab" data-i="${i}" aria-selected="${i?'false':'true'}">${E(sh.name)}</button>`).join('')}</nav>`:'<div style="height:10px"></div>';
    const script=`<script>document.querySelectorAll('nav button').forEach(function(b){b.onclick=function(){document.querySelectorAll('nav button').forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false')});document.querySelectorAll('.pane').forEach(function(p,i){p.hidden=String(i)!==b.dataset.i})}})<\/script>`;
    shell(`<header><div><h1>${E(d.f||'Spreadsheet')}</h1><div class="sub">Read-only view · ${sheets.length} sheet${sheets.length===1?'':'s'}${d.wo?' · WO '+E(d.wo):''}</div></div><span class="sp"></span><a class="btn" href="${blobUrl}" download="${E(d.f||'file.xlsx')}">Download original</a><button class="btn" onclick="window.print()">Print</button></header>${nav}<main>${sheets.map(tab).join('')}</main>`,script);
  }catch(err){
    console.error(err);
    shell(`<div class="err"><h1>Could not open this file</h1><p class="sub">${E(err.message||'Something went wrong.')}</p></div>`);
  }
}

// Edit note / Remove buttons on an attached document (Reports page and the record's Attached documents tab)
const findDoc=id=>DOCS.find(x=>String(x.id)===String(id))||RWDOCS.find(x=>String(x.id)===String(id));
const docOwner=d=>d.reworkId?['rework',d.reworkId]:(d.recordId?['record',d.recordId]:null);
async function docChanged(d){
  await refreshLiveContent();
  /* redraw the record page we are on, and stay on its Documents tab */
  const m=/^#\/record\/([^?]+)/.exec(location.hash||'');
  if(m&&document.body.dataset.page==='record'){
    renderRecordPage(decodeURIComponent(m[1]));
    const tab=$('#dTabs button[data-t="dc"],#rwTabs button[data-t="dc"]');if(tab)tab.click();
  }
}
document.addEventListener('click',async e=>{
  const b=e.target.closest('[data-dedit],[data-ddel]');if(!b)return;
  const edit=b.dataset.dedit!==undefined,d=findDoc(edit?b.dataset.dedit:b.dataset.ddel);
  if(!d)return;
  const own=docOwner(d);
  if(edit){
    const next=await askPrompt({title:'Edit note',label:`Note for "${d.f}" (leave empty to clear it):`,value:d.notes||'',confirmLabel:'Save'});
    if(next===null)return;
    const text=next.trim().slice(0,500);
    if(text===(d.notes||'').trim())return;
    b.disabled=true;
    try{
      await authApi('document_update.php',{id:d.id,notes:text});
      if(own)await logEvent(own[0],own[1],'doc_edited',d.f);
      toast('Note saved');
      await docChanged(d);
    }catch(err){toast(err.message,{type:'error'});b.disabled=false}
    return;
  }
  const ok=await askConfirm({title:'Remove this document?',message:`"${d.f}" will be deleted from the portal, including the saved file. This can't be undone. The record it belongs to is not changed.`,confirmLabel:'Remove'});
  if(!ok)return;
  b.disabled=true;
  try{
    await authApi('document_delete.php',{id:d.id});
    if(own)await logEvent(own[0],own[1],'doc_removed',d.f);
    toast('Document removed');
    await docChanged(d);
  }catch(err){toast(err.message,{type:'error'});b.disabled=false}
});

// View / Download buttons (Reports page and the record's Attached documents tab)
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-dview],[data-ddl]');if(!b)return;
  const wantsDl=b.dataset.ddl!==undefined;
  const wantId=String(wantsDl?b.dataset.ddl:b.dataset.dview);
  const d=DOCS.find(x=>String(x.id)===wantId)||RWDOCS.find(x=>String(x.id)===wantId);
  if(!d)return;
  if(!d.hasFile){toast('No saved file for this document: it was added before file saving existed. Open its record and upload it again.',{type:'error'});return}
  const ext=(d.ext||'').toLowerCase();
  if(!wantsDl&&DOC_SHEET.includes(ext)&&window.XLSX){openSheetViewer(d);return}   // Excel / CSV: shown as a table in a new tab
  const inline=DOC_INLINE.includes(ext);
  if(!wantsDl&&!inline)toast("This file type can't be previewed in the browser, so it is downloading instead.");
  window.open(docUrl(d.id,wantsDl||!inline),'_blank','noopener');
});

function setupDocUpload(r){
  const btn=$('#addDocBtn');if(!btn)return;
  const box=$('#addDocBox');
  btn.onclick=()=>{box.hidden=!box.hidden};
  $('#adCancel').onclick=()=>{box.hidden=true};
  $('#adGo').onclick=async()=>{
    const files=[...$('#adFile').files];
    if(!files.length){toast('Choose a file first',{type:'error'});return}
    const big=files.find(f=>f.size>DOC_MAX_BYTES);
    if(big){toast(`"${big.name}" is bigger than 20 MB.`,{type:'error'});return}
    const type=$('#adType').value;
    if(!type){toast('Choose a document type',{type:'error'});return}
    const what=files.length===1?`"${files[0].name}"`:`${files.length} files`;
    const ok=await askConfirm({title:'Upload document?',message:`Upload ${what} to ${r.needsReview?'this record':'WO '+r.wo}?`,confirmLabel:'Upload',danger:false});
    if(!ok)return;
    const fd=new FormData();
    fd.append('csrf',AUTH.csrf);fd.append('record_id',r.id);fd.append('doc_type',type);
    fd.append('uploaded_date',todayISO());fd.append('notes',$('#adNote').value.trim());
    files.forEach(f=>fd.append('files[]',f,f.name));
    const go=$('#adGo');go.disabled=true;
    try{
      const res=await fetch(API_BASE+'document_create.php',{method:'POST',credentials:'same-origin',body:fd});
      let data={};try{data=await res.json()}catch(err){}
      if(res.status===401){AUTH.authenticated=false;goTo('#/login');throw new Error('Please sign in again.')}
      if(!res.ok||!data.success)throw new Error(data.error||'Upload failed');
      await logEvent('record',r.id,'uploaded',files.map(f=>f.name).join(', '));
      await refreshLiveContent();
      toast(files.length>1?`${files.length} documents uploaded`:'Document uploaded');
      renderRecordPage(recKey(r));
      const tab=$('#dTabs button[data-t="dc"]');if(tab)tab.click();
    }catch(err){
      console.error(err);
      toast(err.message,{type:'error'});
      go.disabled=false;
    }
  };
}

function renderRecordPage(wo){
  if(wo.startsWith('rw-')){rwRenderRecordPage(wo.slice(3));return}   // a Rework record opens inside Inspection Records too
  const r=wo.startsWith('id-')?RECORDS.find(x=>String(x.id)===wo.slice(3)):recordByWo(wo);
  const root=$('#p-record');
  if(!r){
    root.innerHTML=`<div class="empty" style="margin:60px auto;max-width:440px;text-align:center">
      <b>${RECORDS.length?'Record not found':'No inspection records yet'}</b>
      <p style="color:var(--muted);margin:6px 0 16px">${RECORDS.length?"That work order number doesn't match any record.":'Records will show up here once they exist in the database.'}</p>
      <a href="#/records" class="btn secondary">Back to records</a>
    </div>`;
    return;
  }
  root.innerHTML=recordPageHTML(r);
  setupRecordTabs();
  setupRecordEdit(r);
  setupDocUpload(r);
  setupFlagButton(r);
  setupDeleteButton(r);
  hydrateIcons(root);
  loadHistory('record',r.id,'#hiList',[['Record logged',formatDate(r.date),r.by]],docsOfRecord(r));
}


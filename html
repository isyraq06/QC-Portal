function viewOnlyToast(key,what){const m=viewOnlyMsg(key,what);VO_LAST={msg:m,t:Date.now()};toast(m,{type:'error',pos:'tr'})}
/* One guard for every request: if a signed-in person without edit rights for a department tries to send a change to it,
   it is stopped here, the top-right message is shown, and the page gets a normal "403" answer. */
(function(){
  const realFetch=window.fetch.bind(window);
  window.fetch=function(input,init){
    try{
      const url=typeof input==='string'?input:(input&&input.url)||'';
      const method=String((init&&init.method)||(input&&input.method)||'GET').toUpperCase();
      if(method==='POST'&&AUTH.authenticated&&typeof API_BASE==='string'&&url.indexOf(API_BASE)===0){
        const path=url.slice(API_BASE.length).split('?')[0];
        const d=deptList().find(x=>x.api.test(path));
        if(d&&!deptCan(d.key,'edit')){
          const m=viewOnlyMsg(d.key);
          viewOnlyToast(d.key);
          return Promise.resolve(new Response(JSON.stringify({ok:false,error:m,view_only:true}),{status:403,headers:{'Content-Type':'application/json'}}));
        }
      }
    }catch(e){console.error(e)}
    return realFetch(input,init);
  };
})();

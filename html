function setupSplit(r){
  const edit=$('#editCard'),split=$('#splitCard');
  $('#eSplit').onclick=()=>{edit.hidden=true;split.hidden=false;renderSplitRows();split.scrollIntoView({behavior:'smooth',block:'center'})};
  $('#sCancel').onclick=()=>{split.hidden=true;edit.hidden=false};

  let run=0;const ptab=vzTable(['Defect reason','Rework lines','Share','Running total'],pItems.map(x=>{run+=x.n;return [x.name,x.n,vzPct(x.n,ptotal)+'%',vzPct(run,ptotal)+'%']}));
  const codes=vzTop(tally(r=>rwTokens(r,'rwCode')),8),ops=vzTop(tally(r=>rwTokens(r,'rwOp')),8);
  const tabOf=(t,h,c)=>vzTable([h,c],t.top.map(x=>[x.name,x.n]));
  const per=vzPeriodSub(rwDashPeriod,'All time');
  const cards=[
    vzCard(`Month by month, ${year}`,'Items inspected per month by result (counted by Ref No). Not affected by the period filter.',legend,vzMonthly(wi(0),S,data,year),mtab),

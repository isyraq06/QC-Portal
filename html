const vzLastW={};
function renderInsights(which){
  vzBindOnce();
  [['ca','#caInsights',vzBuildCA],['rw','#rwInsights',vzBuildRW]].forEach(([k,sel,build])=>{
    if(which&&which!==k)return;
    const host=$(sel);if(!host)return;
    if(!vzAdmin()){host.hidden=true;host.innerHTML='';return}
    host.hidden=false;
    if(!host.clientWidth){vzLastW[k]=0;return}   /* page not on screen yet: the observer redraws when it appears */
    const cw=host.clientWidth,cardW=Math.max(260,Math.round((cw>=1100?(cw-20)/2:cw)-42));
    vzLastW[k]=cw;
    try{
      host.innerHTML=build(cardW);
      /* the grid may be one or two columns: measure a real chart and redraw once at its true width */
      const ws=[...host.querySelectorAll('.vz')].map(el=>el.clientWidth);
      if(ws.length&&ws.every(x=>x>0)&&ws.some(x=>Math.abs(x-cardW)>6))host.innerHTML=build(ws.map(x=>Math.max(240,x)));
    }catch(err){console.error('Insights failed:',err);host.innerHTML=''}
  });
}
if(typeof ResizeObserver!=='undefined'&&!window.__vzRO){

    $('#sSave').disabled=true;
    try{
      const res=await fetch(API_BASE+'record_split.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:r.id,material:$('#sMat').value.trim(),rows})});

var NUM_FIELDS=['output_h1','output_h2','reject_h1','rework_h1','reject_h2','rework_h2','absent','late','upl','mc','drawing','skill','cooperation','obey','rules','colleagues','maintenance','problem_solving','corrective','leadership'];


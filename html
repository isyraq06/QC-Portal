async function rwConfirmBulk(){
  const toImport=rwBulkRows.filter(r=>!r._dup);
  if(!toImport.length){toast('Nothing new to import',{type:'error'});return}
  const ok=await askConfirm({title:'Import these records?',message:`Import ${toImport.length} new line${toImport.length===1?'':'s'} from “${rwBulkFile?rwBulkFile.name:'this file'}” into Rework? Only this file is imported; the next file (if any) will ask again.`,confirmLabel:'Import this file',danger:false});
  if(!ok)return;
  const batchNote=$('#rwBulkNote').value.trim();
  const btn=$('#rwBulkConfirm');btn.disabled=true;btn.textContent='Importing…';
  try{
    // The server numbers repeat lines itself, so send EVERY row of the file (in order) and let it skip what already exists.
    const send=rwBulkRows.map(r=>({inspection_date:r.inspection_date,ref_no:r.ref_no,so_no:r.so_no,result:r.result,inspected_by:r.inspected_by,
      rw_process_code:r.rw_process_code,rw_category:r.rw_category,rw_reason:r.rw_reason,rw_qty:r.rw_qty,rw_operator:r.rw_operator,
      rp_category:r.rp_category,rp_reason:r.rp_reason,rp_qty:r.rp_qty,notes:batchNote}));
    const {res,data}=await rwPost('rework_bulk_import.php',{records:send});
    if(!res.ok||!data.success)throw new Error(data.error||'Import failed');
    let fileMsg='';
    if(data.inserted>0&&rwBulkFile){
      try{
        const fd=new FormData();
        fd.append('csrf',AUTH.csrf);fd.append('batch','1');fd.append('section','rework');fd.append('doc_type','Imported Excel');fd.append('uploaded_date',todayISO());
        fd.append('notes',[`Bulk import: ${data.inserted} line${data.inserted===1?'':'s'}`+(data.flagged?` (${data.flagged} need review)`:''),batchNote].filter(Boolean).join(' — ').slice(0,500));
        fd.append('files[]',rwBulkFile,rwBulkFile.name);
        const dres=await fetch(API_BASE+'document_create.php',{method:'POST',credentials:'same-origin',body:fd});
        let dd={};try{dd=await dres.json()}catch(e){}
        if(!dres.ok||!dd.success)throw new Error(dd.error||'upload failed');
      }catch(err){console.error(err);fileMsg=`The records were imported, but the Excel file itself couldn't be saved: ${err.message}`}
    }
    await refreshLiveContent();
    toast(`${data.inserted} line${data.inserted===1?'':'s'} imported`+(data.flagged?` (${data.flagged} need review)`:''));
    if(fileMsg)toast(fileMsg,{type:'error'});
    rwBulkQ.finish('done');
  }catch(err){console.error(err);toast('Import failed: '+err.message,{type:'error'})}
  finally{btn.disabled=false;btn.innerHTML='<i data-i="upload"></i>Import records';hydrateIcons()}
}


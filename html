function evMap(){const m={};EV.evals.forEach(e=>{(m[e.worker_id]=m[e.worker_id]||{})[+e.month]=EvalCore.normalize(e)});return m}
function evSort(a,b){return String(a.section||'').localeCompare(String(b.section||''),undefined,{numeric:true,sensitivity:'base'})||String(a.emp_no||'').localeCompare(String(b.emp_no||''),undefined,{numeric:true,sensitivity:'base'})}
function evShown(){const has=new Set(EV.evals.map(e=>String(e.worker_id)));return EV.workers.filter(w=>+w.is_active||has.has(String(w.id))).sort(evSort)}
function evPctClass(p){return p>=0.9?'gr':p>=0.8?'am':'rd'}
function evPct2(p){return (Math.round(p*10000)/100).toFixed(2)+'%'}

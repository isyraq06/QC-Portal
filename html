.bar span{display:block;height:100%}
.bar .p{background:var(--pass)}.bar .w{background:#E8A33A}.bar .f{background:var(--fail)}
.legend{display:grid;gap:10px;margin-top:18px}
.legend div{display:flex;align-items:center;justify-content:space-between}
.legend span{display:flex;align-items:center;gap:9px;color:var(--muted)}
.legend i{width:10px;height:10px;border-radius:3px;display:block}
.legend b{font-weight:700}

/* ---------- items toolbar ---------- */
.toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}
.toolbar .with-ic{flex:1 1 300px;min-width:240px}
.toolbar .sel{width:auto;min-width:150px}
.toolbar2{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 20px;border-bottom:1px solid var(--line)}

/* ---------- item detail ---------- */
.crumb{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13.5px;margin:4px 0 14px}
.crumb a:hover{color:var(--primary)}
.summary{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:24px 26px;margin-bottom:20px;border-left:5px solid var(--accent)}
.summary.pass{border-left-color:var(--pass)}.summary.pending{border-left-color:#E8A33A}.summary.fail{border-left-color:var(--fail)}
.summary h1{font-size:26px;letter-spacing:-.02em;font-weight:700;line-height:1.2}
.summary .sub{color:var(--muted);margin-top:4px}
.summary .facts{display:flex;gap:34px;flex-wrap:wrap;margin-top:16px}
.fact small{display:block;color:var(--muted);font-size:12.5px}
.fact b{font-weight:700;font-size:15px}
.dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 28px}
.dl div small{display:block;color:var(--muted);font-size:12.5px;margin-bottom:2px}
.dl div b{font-weight:600;font-size:14.5px}
.detail{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(0,1fr);gap:20px;align-items:start}
.stack{display:grid;gap:20px}
/* Rework overview: Recent records on top, the two defect-category cards side by side underneath */
#rwOverview .dash{grid-template-columns:minmax(0,1fr)!important}
#rwOverview .stack{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
@media (max-width:760px){#rwOverview .stack{grid-template-columns:minmax(0,1fr)}}
.hist-last{margin:0 0 14px;color:var(--muted);font-size:13px}
.ownc{text-align:right;font-size:12.5px;line-height:1.5;color:var(--muted)}
.ownc a{color:var(--primary);font-weight:600}
.ownc a:hover{text-decoration:underline}
.hist-last b{color:var(--ink)}
.tl{list-style:none;margin:0;padding:0 0 0 6px}
.tl li{position:relative;padding:0 0 18px 24px;border-left:2px solid var(--line-strong)}
.tl li:last-child{padding-bottom:0;border-color:transparent}
.tl li::before{content:"";position:absolute;left:-7px;top:3px;width:12px;height:12px;border-radius:50%;background:var(--card);border:3px solid var(--accent)}
.tl li.done::before{background:var(--accent)}
.tl small{display:block;color:var(--muted);font-size:12.5px}
.tl b{font-weight:600}
.doc{display:flex;align-items:center;gap:12px;padding:12px 20px;border-bottom:1px solid var(--line)}
.doc:last-child{border-bottom:0}
.doc .m{flex:1;min-width:0}
.doc .m b{display:block;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:13.5px}
.doc .m small{color:var(--muted);font-size:12.5px}
.dnote{display:block;margin-top:4px;color:var(--muted);font-size:12.5px;font-style:italic;white-space:normal;line-height:1.4;max-width:60ch}
.dnote::before{content:"Note: ";font-style:normal;font-weight:700}
.notei{display:inline-flex;align-items:center;justify-content:center;vertical-align:middle;width:25px;height:25px;margin-left:8px;border-radius:50%;background:var(--primary);color:var(--on-primary);box-shadow:0 1px 3px rgba(10,42,66,.28);cursor:help}
.notei svg{width:14px;height:14px}
.result-box{display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.result-box p{color:var(--muted)}

/* ---------- upload ---------- */
.up{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:20px;align-items:start}
.drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;padding:44px 24px;border:2px dashed var(--line-strong);border-radius:12px;background:var(--card-alt);cursor:pointer;transition:border-color .15s,background .15s}
.drop:hover,.drop.over{border-color:var(--accent);background:var(--accent-soft)}
.drop .big{width:54px;height:54px;border-radius:50%;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;color:var(--primary);margin-bottom:6px}
.drop .big .ic{width:24px;height:24px}
.drop b{font-size:16px}
.drop span{color:var(--muted);font-size:13px}
.form2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form2 .full{grid-column:1/-1}

/* ---------- settings ---------- */
.set{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;align-items:start}
.setnav{display:flex;flex-direction:column;gap:3px;padding:8px}
.setnav button{display:flex;align-items:center;gap:11px;border:0;background:none;padding:10px 12px;border-radius:9px;font-weight:600;color:var(--muted);cursor:pointer;text-align:left}
.setnav button:hover{background:var(--hover)}
.setnav button.on{background:var(--accent-soft);color:var(--primary)}
.row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.row small{display:block;color:var(--muted)}
.row b{font-weight:600}
.toggle{width:44px;height:26px;border-radius:999px;background:var(--line-strong);border:0;position:relative;cursor:pointer;flex:none;transition:background .15s}
.toggle::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .15s}
.toggle.on{background:var(--primary)}
.toggle.on::after{transform:translateX(18px)}

/* ---------- login ---------- */
.login{position:relative;z-index:1;min-height:100vh;display:grid;place-items:center;padding:32px 20px 110px}
.lcard{width:100%;max-width:420px;padding:36px 34px 30px;border-radius:16px;position:relative}
.lcard .brand{padding:0 0 22px}
.lcard .brand svg{color:var(--primary)}
.lcard .brand b{color:var(--ink)}
.lcard h1{font-size:26px;letter-spacing:-.02em;font-weight:700}
.lcard p.s{color:var(--muted);margin:6px 0 24px}
.lcard form{display:grid;gap:16px}
.lfoot{margin-top:22px;text-align:center;color:var(--muted);font-size:12.5px}
.remember{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);cursor:pointer;user-select:none}
.remember input{width:16px;height:16px;accent-color:var(--primary);cursor:pointer}
.authnote{background:var(--accent-soft);color:var(--ink);border-radius:10px;padding:12px 14px;font-size:13px;margin-bottom:16px;line-height:1.5}
.field.err .inp{border-color:var(--fail)}
.field.err label{color:var(--fail)}
.errmsg{font-size:12.5px;color:var(--fail);margin-top:-2px}

/* ---------- toast ---------- */
.toast{position:fixed;left:50%;bottom:84px;background:var(--navy);color:#fff;padding:12px 20px;border-radius:999px;font-weight:600;z-index:80;box-shadow:0 10px 30px rgba(0,0,0,.25);display:flex;gap:10px;align-items:center;transform:translate(-50%,10px) scale(.96);opacity:0;transition:transform .28s cubic-bezier(.34,1.56,.64,1),opacity .22s ease}
.toast.on{transform:translate(-50%,0) scale(1);opacity:1}
.anntype{display:inline-flex;gap:4px;padding:4px;margin-top:12px;border-radius:99px;background:color-mix(in srgb,var(--navy,#0A2A3F) 7%,transparent)}
.anntype button{display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border:0;border-radius:99px;background:transparent;font:inherit;font-weight:700;color:var(--muted);cursor:pointer;transition:background .2s,color .2s,box-shadow .2s}
.anntype button svg{width:17px;height:17px}
.anntype button.on{background:#fff;color:#0A2A3F;box-shadow:0 2px 8px rgba(10,42,63,.15)}
.anntype button[data-annk=incoming].on{background:linear-gradient(135deg,#F59E0B,#EF4444);color:#fff}
.annrow{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:12px}
.anncard.inc .annic{background:linear-gradient(160deg,#fff,#FFF1D6);color:#B45309;flex-direction:column;gap:0;line-height:1;border:1px solid #F5C26B}
.anncard.inc .annic b{font-size:22px;font-weight:800}.anncard.inc .annic i{font-style:normal;font-size:11px;font-weight:800;letter-spacing:.08em;margin-top:3px}
.anncard.inc{border-left-color:#F59E0B}
.annbadge{display:inline-flex;align-items:center;gap:6px;padding:4px 11px 4px 9px;border-radius:99px;font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#fff}
.annbadge svg{width:14px;height:14px}
.annbadge.ann{background:linear-gradient(135deg,#7C4DCC,#3B8BFF)}
.annbadge.inc{background:linear-gradient(135deg,#F59E0B,#EF4444)}
.anninc{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;background:#FFF1D6;color:#9A5B00;font-size:12px;font-weight:800}
.anninc.soon{background:#FEE2E2;color:#B91C1C}
.annexp{display:inline-flex;padding:3px 10px;border-radius:99px;background:#E5E7EB;color:#4B5563;font-size:12px;font-weight:800}
.anncard.gone{opacity:.6}
.anndue{font-size:13px;color:var(--muted);margin:2px 0 0}
.toast.tr{left:auto;right:24px;top:20px;bottom:auto;max-width:min(380px,calc(100vw - 32px));border-radius:14px;align-items:flex-start;transform:translate(24px,0) scale(.96)}
.toast.tr.on{transform:none}
.toast.tr.out{transform:translate(24px,0) scale(.97);opacity:0}
@media (max-width:640px){.toast.tr{right:16px;top:64px}}
.toast.out{transform:translate(-50%,6px) scale(.97);opacity:0;transition:transform .18s ease,opacity .18s ease}
.toast .ic{flex:none}
.toast.error{background:var(--fail-bg);color:var(--fail);box-shadow:0 10px 30px color-mix(in srgb,var(--fail) 30%,transparent),0 0 0 1px color-mix(in srgb,var(--fail) 25%,transparent) inset}
.toast.error .ic{color:var(--fail)}
.toast.error .toast-undo{color:var(--fail);border-left-color:color-mix(in srgb,var(--fail) 30%,transparent)}
.toast.error .toast-undo:hover{color:color-mix(in srgb,var(--fail) 70%,black)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){.toast.error{box-shadow:0 10px 30px rgba(0,0,0,.35),0 0 0 1px color-mix(in srgb,var(--fail) 35%,transparent) inset}}}
.toast-undo{background:transparent;border:0;padding:0 0 0 10px;margin-left:2px;border-left:1px solid rgba(255,255,255,.3);color:#8FCBFF;font-weight:700;font-size:inherit;font-family:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px}
.toast-undo:hover{color:#fff}
.confirm-scrim{position:fixed;inset:0;background:rgba(10,24,34,.5);display:flex;align-items:center;justify-content:center;z-index:100;padding:20px;opacity:0;pointer-events:none;transition:opacity .2s ease}
.confirm-scrim.on{opacity:1;pointer-events:auto}
.confirm-card{transform:translateY(16px) scale(.96);opacity:0;transition:transform .28s cubic-bezier(.34,1.56,.64,1),opacity .2s ease}
.confirm-scrim.on .confirm-card{transform:translateY(0) scale(1);opacity:1}
@media (prefers-reduced-motion:reduce){.confirm-scrim,.confirm-card{transition:none}}
.confirm-card{width:100%;max-width:380px;padding:24px;box-shadow:0 20px 60px rgba(10,42,66,.28)}
.confirm-card h3{font-size:17px;font-weight:700;letter-spacing:-.01em}
.confirm-card p{color:var(--muted);margin-top:8px;font-size:14px;line-height:1.5}
.confirm-card .acts{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}
.page{display:none}
.page.show{display:block}
.login.page.show{display:grid}

/* ---------- responsive ---------- */
@media (max-width:1180px){
  .shell{grid-template-columns:76px minmax(0,1fr)}
  .side{padding:22px 10px 18px;align-items:center}
  .brand{padding:2px 0 24px}.brand div,.nav a span,.userchip div,.navlabel,.navgrouphead span,.navchev{display:none}
  .nav a{justify-content:center;padding:12px}.nav a.on::before{left:-10px}
  .userchip{justify-content:center;padding:12px 0}
  .stats{grid-template-columns:repeat(2,1fr)}
  .dash,.detail,.up{grid-template-columns:1fr}
  .main{padding:0 28px 100px}
}
@media (max-width:820px){
  .shell{grid-template-columns:1fr}
  .side{position:fixed;left:0;top:0;bottom:0;width:250px;height:auto;align-items:stretch;transform:translateX(-100%);transition:transform .2s;padding:calc(22px + env(safe-area-inset-top,0px)) 14px 18px}
  .side.open{transform:none}
  .side .brand div,.side .nav a span,.side .userchip div,.side .navlabel,.side .navgrouphead span{display:block}.side .navchev{display:flex}
  .side .nav a{justify-content:flex-start;padding:10px 12px}
  .side .userchip{justify-content:flex-start;padding:12px 10px}
  .scrim.on{display:block;position:fixed;inset:0;background:rgba(6,20,32,.5);z-index:25}
  .menubtn{display:grid}
  .main{padding:0 16px 100px}
  .topbar .today{display:none}
  .hero{padding:26px 20px}.hero h1{font-size:28px}
  .set{grid-template-columns:1fr}
  .setnav{flex-direction:row;overflow-x:auto}
  .form2,.dl{grid-template-columns:1fr}
  .ph h1{font-size:24px}
}
@media (max-width:520px){.stats{grid-template-columns:1fr 1fr;gap:12px}.stat .n{font-size:28px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}

/* ---------- merged additions: mono id, bar rows, editable lists ---------- */
.mono{font-variant-numeric:tabular-nums;letter-spacing:.01em}
.barrows{display:grid;gap:13px}
.barrow{display:grid;grid-template-columns:96px 1fr 26px;align-items:center;gap:12px;font-size:13px}
.barrow .lbl{color:var(--muted)}
.barrow .track{height:8px;border-radius:999px;background:var(--line);overflow:hidden}
.barrow .fill{height:100%;background:var(--accent);border-radius:999px}
.barrow .val{text-align:right;font-weight:700}
.eitem{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 2px;border-bottom:1px solid var(--line)}
.eitem:last-child{border-bottom:0}
.eitem .lbl{display:flex;align-items:center;gap:10px;font-weight:600}
.eitem .swatch{width:10px;height:10px;border-radius:3px;display:inline-block;flex:none}
.eitem .acts{display:flex;gap:4px;flex:none}
.eitem button.link{border:0;background:none;color:var(--primary);font-weight:600;font-size:12.5px;cursor:pointer;padding:5px 9px;border-radius:6px}
.eitem button.link:hover{background:var(--accent-soft)}
.eitem button.link.danger{color:var(--fail)}
.eitem button.link.danger:hover{background:var(--fail-bg)}
.add-row{display:flex;gap:8px;margin-top:12px}
.add-row .inp{height:38px}
.defect-marked td{background:var(--fail-bg)}
.chk-yes{color:var(--fail);display:inline-flex;align-items:center;gap:6px;font-weight:700}
.chk-yes .ic{width:15px;height:15px}
.upmode{display:flex;background:var(--card-alt);border:1px solid var(--line);border-radius:999px;padding:3px;gap:2px;margin-bottom:20px;max-width:600px}
.upmode button{flex:1;border:0;background:transparent;height:38px;border-radius:999px;font-weight:600;font-size:13.5px;color:var(--muted);cursor:pointer}
.upmode button.on{background:var(--primary);color:var(--on-primary)}
.nrdefs{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin-top:6px}
.nrdef{display:flex;flex-direction:column;gap:8px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--card)}
.nrdef label{display:flex;gap:8px;align-items:center;font-weight:600;font-size:13.5px;cursor:pointer}
.nrdef .inp{height:34px}
.bulk-drop{display:flex;flex-direction:column;align-items:center;justify-content:center;border:2px dashed var(--line);border-radius:14px;padding:32px;text-align:center;cursor:pointer;transition:border-color .15s,background .15s}
.bulk-drop:hover,.bulk-drop.over{border-color:var(--primary);background:var(--accent-soft)}
.bulk-drop .ic{width:32px;height:32px;color:var(--muted);margin:0 auto 10px;display:block}
.bulk-summary{display:flex;gap:24px;flex-wrap:wrap;margin:16px 0;padding:14px 16px;background:var(--card-alt);border-radius:10px}
.bulk-summary .stat b{font-size:20px;display:block}
.bulk-summary .stat small{color:var(--muted)}
.bulk-preview-wrap{max-height:360px;overflow:auto;border:1px solid var(--line);border-radius:10px;margin:12px 0}
.bulk-preview-wrap table{width:100%;border-collapse:collapse;font-size:12.5px}
.bulk-preview-wrap th{position:sticky;top:0;background:var(--card);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
.bulk-preview-wrap td{padding:7px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
.bulk-preview-wrap tr.dup td{background:var(--pend-bg)}
.badge.none{background:var(--accent-soft);color:var(--muted)}
.dataswitch{margin:0 0 18px}
#recRW .t{width:max-content;min-width:100%}
#recRW .t th,#recRW .t td{white-space:nowrap}
.dataswitch button{height:38px;padding:0 24px}
.rwh{margin:6px 0 -4px;font-size:14px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.also-card{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 16px;padding:12px 16px}
.bulk-also-tag{font-size:11px;font-weight:700;color:#1F9C9C;background:color-mix(in srgb,#1F9C9C 14%,var(--card));padding:2px 8px;border-radius:999px;white-space:nowrap}
/* multi-file upload queue */
.upq{margin-top:14px;border:1px solid var(--line);border-radius:12px;background:var(--card-alt);overflow:hidden}
.upq .qh{padding:12px 16px;font-size:13.5px;color:var(--muted);line-height:1.5;border-bottom:1px solid var(--line)}
.upq .qh b{color:var(--ink,inherit)}
.upq .qr{display:flex;align-items:center;gap:12px;padding:9px 16px;border-bottom:1px solid var(--line);font-size:13.5px}
.upq .qr:last-child{border-bottom:0}
.upq .qr.cur{background:color-mix(in srgb,var(--primary) 8%,var(--card))}
.upq .qn{flex:none;width:22px;color:var(--muted);font-weight:700}
.upq .qf{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}
.upq .qs{flex:none;color:var(--muted);font-size:12px}
.upq .qc{flex:none;font-size:11.5px;font-weight:700;padding:3px 10px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--muted)}
.upq .qc.cur{background:var(--primary);border-color:var(--primary);color:var(--on-primary)}
.upq .qc.done{background:var(--pass-bg);border-color:transparent;color:var(--pass)}
.upq .qc.moved{background:color-mix(in srgb,#1F9C9C 14%,var(--card));border-color:transparent;color:#1F9C9C}
.upq .qx{flex:none}
.fileinfo{display:flex;flex-direction:column;gap:4px;margin:0 0 16px;padding:14px 16px;border-radius:12px;background:var(--accent-soft);border:1px solid var(--line);font-size:13.5px;line-height:1.5}
.fileinfo .t{font-size:15px;font-weight:800}
.bulk-dup-tag{font-size:11px;font-weight:700;color:var(--pend);background:var(--pend-bg);padding:2px 8px;border-radius:999px}
.bulk-preview-wrap tr.review td{background:var(--review-bg)}
.bulk-review-tag{font-size:11px;font-weight:700;color:#fff;background:var(--review);padding:2px 8px;border-radius:999px}
:root{--review:#7C3AED;--review-bg:#EFE7FE}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--review:#B794F6;--review-bg:#2E2050}}
:root[data-theme="dark"]{--review:#B794F6;--review-bg:#2E2050}
.review-tag{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;background:var(--review);color:#fff;font-size:12px;font-weight:700;white-space:nowrap}
.t tbody tr.review-row td{background:var(--review-bg)}
.t tbody tr.review-row td:first-child{box-shadow:inset 4px 0 0 var(--review)}
.t tbody tr.click.review-row:hover td{background:color-mix(in srgb,var(--review) 16%,var(--card))}
.review-btn{height:34px;padding:0 14px;border-radius:999px;border:1.5px solid var(--review);background:var(--review-bg);color:var(--review);font-weight:700;font-size:13.5px;cursor:pointer;display:inline-flex;align-items:center;gap:8px}
.review-btn em{font-style:normal;background:var(--review);color:#fff;border-radius:999px;padding:0 8px;font-size:12px;min-width:22px;text-align:center}
.review-btn.on{background:var(--review);color:#fff}
.review-btn.on em{background:#fff;color:var(--review)}
.warn-note{display:flex;gap:10px;align-items:flex-start;background:var(--pend-bg);color:var(--pend);border-radius:12px;padding:11px 14px;margin-bottom:14px;font-size:13.5px;font-weight:600;line-height:1.45}
.warn-note b{font-weight:800}
.review-card{border-color:var(--review);box-shadow:0 0 0 3px color-mix(in srgb,var(--review) 18%,transparent);margin-bottom:20px}
#editCard,#splitCard{margin-bottom:20px}
.srow{display:grid;grid-template-columns:1.5fr 1fr 1.5fr .6fr .6fr;gap:10px;margin-bottom:10px}
.srow .inp{height:38px;min-width:0}
.shead{font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px}
@media (max-width:820px){.srow{grid-template-columns:1fr 1fr}.shead{display:none}}
/* ---------- dashboard insights (administrators and the Owner only) ---------- */
.insights{--vz-2:#eb6834;margin-top:26px}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .insights{--vz-2:#d95926}}
:root[data-theme="dark"] .insights{--vz-2:#d95926}
.vz-head{display:flex;align-items:center;gap:12px;margin:0 0 14px}
.vz-head h3{font-size:16px;margin:0}
.vz-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin:0 0 20px}
.vz-tile{display:flex;flex-direction:column;gap:8px;padding:16px 18px}
.vz-tile .l{color:var(--muted);font-weight:600;font-size:13px}
.vz-tile .v{font-size:30px;font-weight:700;letter-spacing:-.03em;line-height:1;font-variant-numeric:proportional-nums}
.vz-tile .v.txt{font-size:20px;line-height:1.25;letter-spacing:-.01em;word-break:break-word}
.vz-tile .s{color:var(--muted);font-size:12.5px}
.vz-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}
#caInsights .vz-grid>.vz-card:first-child{grid-column:1/-1}
#rwInsights .vz-grid>.vz-card:nth-child(-n+2){grid-column:1/-1}
@media (max-width:1100px){.vz-grid{grid-template-columns:minmax(0,1fr)}}
.vz-card .ch{align-items:flex-start}
.vz-card .ch h2{font-size:15px}
.vz-card .ch small{display:block;color:var(--muted);font-size:12.5px;font-weight:500;margin-top:2px}
.vz-card .cb{padding-top:6px}
.vz-legend{display:flex;flex-wrap:wrap;gap:6px 16px;margin:0 0 8px;font-size:12.5px;color:var(--muted)}
.vz-legend span{display:inline-flex;align-items:center;gap:7px}
.vz-sw{display:inline-grid;place-items:center;width:16px;height:16px;border-radius:4px;color:#fff;font-size:10.5px;font-weight:800;line-height:1}
.vz-ln{display:inline-block;width:18px;height:0;border-top:2px solid var(--vz-2);border-radius:2px}
.vz svg{display:block;width:100%;height:auto;overflow:visible}
.vz text{font-family:inherit;fill:var(--muted);font-size:11.5px}
.vz .ink{fill:var(--ink)}
.vz .b{font-weight:700}
.vz .grid{stroke:var(--line);stroke-width:1}
.vz .hit{fill:transparent;cursor:default}
.vz .hit:hover,.vz .hit:focus{fill:color-mix(in srgb,var(--accent) 9%,transparent);outline:none}
.vz .hit:focus-visible{stroke:var(--accent);stroke-width:2}
.vz-empty{color:var(--muted);padding:26px 0;text-align:center;font-size:13.5px}
.vz-tbl{overflow:auto;max-height:340px}
.vz-tbl table{width:100%}
.vz-tip{position:fixed;z-index:200;pointer-events:none;min-width:150px;max-width:280px;padding:10px 12px;border-radius:10px;background:var(--card);border:1px solid var(--line-strong);box-shadow:0 8px 24px rgba(10,42,66,.18);font-size:12.5px;line-height:1.4}
.vz-tip .h{color:var(--muted);font-weight:600;margin-bottom:6px}
.vz-tip .r{display:flex;align-items:center;gap:8px;margin-top:3px}
.vz-tip .k{flex:none;width:12px;height:0;border-top:3px solid var(--accent);border-radius:2px}
.vz-tip .r b{color:var(--ink);font-weight:700;margin-left:auto;padding-left:12px}
.vz-tip .r span{color:var(--muted)}


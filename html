function toast(msg,opts={}){
  if(opts.pos!=='tr'&&VO_LAST.msg&&msg===VO_LAST.msg&&Date.now()-VO_LAST.t<2500)return;
  const isErr=opts.type==='error'||opts.type==='warn';
  const t=document.createElement('div');
  t.className='toast'+(isErr?' error':'')+(opts.pos==='tr'?' tr':'');
  t.setAttribute('role',isErr?'alert':'status');
  t.innerHTML=`${icon(isErr?'warn':'check')}<span>${esc(msg)}</span>`;
  let timer;
  if(opts.undo){
    const btn=document.createElement('button');
    btn.className='toast-undo';
    btn.type='button';
    btn.textContent='Undo';
    btn.onclick=()=>{clearTimeout(timer);opts.undo();dismiss();};
    t.appendChild(btn);
  }
  document.body.appendChild(t);
  requestAnimationFrame(()=>requestAnimationFrame(()=>t.classList.add('on')));
  function dismiss(){
    clearTimeout(timer);
    t.classList.remove('on');
    t.classList.add('out');
    t.addEventListener('transitionend',()=>t.remove(),{once:true});
    setTimeout(()=>t.remove(),250);   // fallback in case transitionend doesn't fire
  }
  timer=setTimeout(dismiss,isErr?3200:2200);
}

let confirmResolve=null;
function askConfirm({title,message,confirmLabel='Remove',danger=true}){
  return new Promise(resolve=>{
    confirmResolve=resolve;
    $('#confirmTitle').textContent=title;
    $('#confirmMsg').textContent=message;
    $('#confirmOk').textContent=confirmLabel;
    $('#confirmOk').className='btn '+(danger?'danger':'primary');

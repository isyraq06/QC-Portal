  let ev=[];
  try{const d=await fetchJson('record_events.php?kind='+kind+'&id='+encodeURIComponent(id));ev=d.events||[]}
  catch(e){console.warn('History log not available (has migration_record_history.sql been run?):',e.message);return}
  if(!document.body.contains(ul))return;
  ul.innerHTML=histListHTML(base,ev,docs);
  const last=ev.find(e=>e.action==='edited'),box=ul.parentNode.querySelector('.hist-last');

   4. SEARCH BOX with live suggestions
      onPick = optional callback (used by the Upload page picker)
   ========================================================= */
/* ---------- Recent searches (the last 3 searches this person ran that found something; kept per person in this browser) ---------- */
const RECENT_MAX=3;
const recentKey=()=>'qc_recent_searches_'+((AUTH.user&&AUTH.user.id)||'anon');
function recentGet(){try{const a=JSON.parse(localStorage.getItem(recentKey())||'[]');return Array.isArray(a)?a.filter(x=>typeof x==='string'&&x).slice(0,RECENT_MAX):[]}catch(e){return []}}
function recentRemember(term){
  term=String(term||'').trim().slice(0,40);
  if(!term||!findRecords(term).length)return;           // only searches that found something
  const list=[term].concat(recentGet().filter(x=>x.toLowerCase()!==term.toLowerCase())).slice(0,RECENT_MAX);
  try{localStorage.setItem(recentKey(),JSON.stringify(list))}catch(e){}
  recentRender();
}
function recentClear(){try{localStorage.removeItem(recentKey())}catch(e){}recentRender()}
function recentRender(){
  const box=$('#heroRecent');if(!box)return;
  const list=recentGet();
  box.innerHTML=list.length
    ?'Recent: '+list.map(t=>`<a class="chip" href="#/records?q=${encodeURIComponent(t)}" data-rs="${esc(t)}">${esc(t)}</a>`).join('')+`<button type="button" id="recentClear" style="border:0;background:none;color:var(--muted);font:inherit;font-size:12.5px;cursor:pointer;text-decoration:underline;padding:4px">Clear</button>`
    :'Recent: <span style="opacity:.8">your last searches will show here</span>';
  $$('[data-rs]',box).forEach(a=>a.onclick=e=>{e.preventDefault();$('#heroQ').value=a.dataset.rs;$('#heroGo').click()});
  const c=$('#recentClear');if(c)c.onclick=recentClear;
}

function setupSearchBox(input,box,onPick){
  input.addEventListener('input',()=>{
    const q=input.value;
    if(!q.trim()){box.hidden=true;return}
    const all=findRecords(q), shown=all.slice(0,5);
    const seeAll=(!onPick&&all.length>shown.length)
      ?`<a class="sg-all" href="#/records?q=${encodeURIComponent(q.trim())}"><span>See all ${all.length} results</span>${icon('chevron')}</a>`:'';
    box.innerHTML=shown.length
      ?shown.map(r=>`<a href="${onPick?'#':'#/record/'+recKey(r)}" data-wo="${r.wo}"><b class="mono">${r.wo}</b><span class="d">${esc(r.spec)} · ${r.so}</span></a>`).join('')+seeAll
      :`<div class="sg-empty">No record matches "${esc(q)}". Check the WO or S/Order number.</div>`;
    box.hidden=false;
    if(onPick)$$('a',box).forEach(a=>a.onclick=e=>{e.preventDefault();onPick(a.dataset.wo);box.hidden=true});
    else if(input.id==='heroQ')$$('a[data-wo]',box).forEach(a=>a.addEventListener('click',()=>recentRemember(a.dataset.wo)));
  });

  input.addEventListener('keydown',e=>{
    if(e.key==='Escape')box.hidden=true;
    if(e.key==='Enter'&&!onPick){
      e.preventDefault();
      if(input.id==='heroQ')recentRemember(input.value);
      const m=findRecords(input.value);
      if(m.length===1)goTo('#/record/'+recKey(m[0]));
      else if(input.value.trim())goTo('#/records?q='+encodeURIComponent(input.value.trim()));
    }
  });

  document.addEventListener('click',e=>{if(!input.parentElement.contains(e.target))box.hidden=true});
}

function setupSearchBoxes(){
  setupSearchBox($('#heroQ'),$('#heroSg'));
}


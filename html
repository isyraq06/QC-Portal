function parseSplit(text,fallbackPrefix){
  const t=String(text||'').trim().replace(/^[\s*＊•]+/,'');   // ignore a leading * ("same order as above")
  let m=t.match(/^(.*-)(\d+(?:\s*[,，]\s*\d+)*)\s*[,，]?\s*(\/\d+)?\s*$/);   // SO2605-0053-18, 14, 10/66
  if(m)return {prefix:m[1],nums:m[2].split(/\s*[,，]\s*/),suffix:m[3]||''};
  m=t.match(/^(\d+(?:\s*[,，]\s*\d+)*)\s*[,，]?\s*(\/\d+)?\s*$/);
  if(m)return {prefix:fallbackPrefix||'',nums:m[1].split(/\s*[,，]\s*/),suffix:m[2]||''};
  return {prefix:'',nums:[],suffix:''};
}

/* Material dropdown (keeps the current value even if it is not in the materials list) */
function materialSelectHTML(id,current){
  const cur=(current||'').trim();
  const list=cur&&!MATERIALS.includes(cur)?[cur,...MATERIALS]:MATERIALS;
  return `<select id="${id}" class="sel"><option value="">Select material</option>`+
    list.map(m=>`<option value="${esc(m)}"${m===cur?' selected':''}>${esc(m)}</option>`).join('')+`</select>`;
}

/* "SO2605-0053-23/66" -> {prefix:'SO2605-0053-', suffix:'/66'} (null if it is not a single item) */
function orderInfo(so){
  const m=String(so||'').trim().match(/^(.*-)(\d+)(\/\d+)?$/);
  return m?{prefix:m[1],suffix:m[3]||''}:null;
}
/* Another record of the SAME order (same prefix) tells us the "/66" ending and the material */
function refByPrefix(prefix){
  if(!prefix)return null;
  const same=RECORDS.filter(x=>{const o=orderInfo(x.so);return o&&o.prefix===prefix&&o.suffix});
  const hit=same.find(x=>x.material)||same[0];
  return hit?{suffix:orderInfo(hit.so).suffix,material:hit.material||''}:null;
}


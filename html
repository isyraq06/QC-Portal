/* ---------- records list ---------- */
const rwFilters={q:'',res:'',type:'',by:'',code:'',op:'',month:'',date:'',sort:'date-d',review:false};
let rwPage=1;const RW_PAGE=100;
function rwResetFilters(v={}){Object.assign(rwFilters,{q:'',res:'',type:'',by:'',code:'',op:'',month:'',date:'',sort:'date-d',review:false},v);rwPage=1}
function rwMatches(r,q){q=q.toLowerCase();return [r.ref,r.so,r.by,r.rwCat,r.rwReason,r.rpCat,r.rpReason,r.rwCode,r.rwOp].some(x=>(x||'').toLowerCase().includes(q))}
const rwSame=(a,b)=>String(a||'').trim().toUpperCase()===String(b||'').trim().toUpperCase();
/* An Operator cell can hold several people ("J11023, AZIZ"). For the filter / lists only, split it into single names.
   The record itself is never changed. */
const rwSplitOps=v=>String(v||'').split(/\s*(?:,|;|\/|&|\+|\n|\band\b)\s*/i).map(x=>x.trim()).filter(Boolean);
/* every individual value in a record for the given field (operators are split, codes are kept whole) */
const rwTokens=(r,field)=>field==='rwOp'?rwSplitOps(r[field]):(String(r[field]||'').trim()?[String(r[field]).trim()]:[]);
/* Options for the Rework Process Code / Operator filters: the designated names from Settings > Lists first,
   then (separately) any other value that already appears in the records, so nothing is hidden. */
function rwDesignatedOptions(list,field,current,allLabel){
  const listed=list.map(x=>x.name);
  const have=new Set(listed.map(x=>x.toUpperCase()));
  const extra=[...new Map(RW.flatMap(r=>rwTokens(r,field)).map(v=>[v.toUpperCase(),v])).values()].filter(v=>!have.has(v.toUpperCase())).sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));
  const opt=v=>`<option value="${esc(v)}"${rwSame(v,current)&&current?' selected':''}>${esc(v)}</option>`;
  return `<option value="">${allLabel}</option>`+listed.map(opt).join('')+(extra.length?`<optgroup label="Other values in records">${extra.map(opt).join('')}</optgroup>`:'');
}
function rwFilterList({ignoreRes=false}={}){
  const f=rwFilters;
  return RW.filter(r=>
    (!f.q||rwMatches(r,f.q.trim()))&&
    (ignoreRes||!f.res||r.result===f.res)&&
    (!f.type||(f.type==='rework'?rwHasRework(r):f.type==='replacement'?rwHasRepl(r):(!rwHasRework(r)&&!rwHasRepl(r))))&&
    (!f.review||r.needsReview)&&
    (!f.by||r.by===f.by)&&
    (!f.code||rwSame(r.rwCode,f.code))&&
    (!f.op||rwSplitOps(r.rwOp).some(x=>rwSame(x,f.op)))&&   // 'AZIZ' also shows rows whose operator is 'J11023, AZIZ'
    (!f.month||(r.date||'').slice(0,7)===f.month)&&
    (!f.date||(r.date&&daysAgo(r.date)<=+f.date))
  );
}
function rwSortList(list){
  const s=rwFilters.sort;
  if(s==='review-first')return list.sort((a,b)=>(+!!b.needsReview)-(+!!a.needsReview)||b.date.localeCompare(a.date));

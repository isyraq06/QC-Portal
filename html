/* Build the whole workbook.
   workers: [{id,emp_no,full_name,section,hire_date,grade}], evals: all saved month records of that year (with worker_id, month)
   opts.only = worker id  -> a workbook with just that worker's sheet */
function buildWorkbook(workers,evals,year,opts){
  opts=opts||{};
  var list=opts.only?workers.filter(function(w){return String(w.id)===String(opts.only);}):workers;
  var S=new Styles(), used={}, sheets=[], calcs=[], recsAll=[];
  var full=!opts.only;
  if(full){ var ls=buildList(S,list); ls.name=safeName(ls.name,used); sheets.push(ls); }
  list.forEach(function(w){
    var recs={}, ev='';
    evals.forEach(function(e){ if(String(e.worker_id)===String(w.id)){ recs[+e.month]=normalize(e); } });
    for(var m=1;m<=12;m++){ if(recs[m]&&recs[m].evaluator_name) ev=recs[m].evaluator_name; }
    var built=buildWorkerSheet(S,safeName(w.emp_no,used),w,year,recs,ev);
    sheets.push(built.sheet); calcs.push(built.calc); recsAll.push(recs);
  });
  if(full && list.length){ var ed=buildEvaluationData(S,list,calcs); ed.name=safeName(ed.name,used); sheets.push(ed); var ar=buildAttendance(S,list,recsAll); ar.name=safeName(ar.name,used); sheets.push(ar); }
  if(!sheets.length) throw new Error('Nothing to export.');
  return xlsxBytes(sheets,S);

/* Month dropdowns: every month (January to December) of each year that has data, newest first,
   so months that have not been uploaded yet can still be picked. */
function monthsToDecember(dataMonths){
  const have=[...new Set(dataMonths.filter(Boolean))].sort();
  if(!have.length)return [];
  const fy=+have[0].slice(0,4),lastYear=+have[have.length-1].slice(0,4);
  const out=[];
  for(let y=fy;y<=lastYear;y++)for(let m=1;m<=12;m++)out.push(`${y}-${String(m).padStart(2,'0')}`);
  return out.reverse();
}
function monthOptionList(dataMonths,selected){
  const withData=new Set(dataMonths.filter(Boolean));
  const label=m=>new Date(m+'-02').toLocaleDateString('en-GB',{month:'long',year:'numeric'});
  return `<option value="">All months</option>`+monthsToDecember(dataMonths).map(m=>`<option value="${m}"${m===selected?' selected':''}>${label(m)}${withData.has(m)?'':' (not uploaded yet)'}</option>`).join('');
}
const monthEmptyHTML=(m,what)=>`<b>${monthLabel(m)}: ${what} haven't been uploaded yet</b>Nothing has been uploaded for this month so far. Once the file is imported, the records will show up here.`;
function recMonthOptionsHTML(selected){
  return monthOptionList(RECORDS.map(r=>r.date.slice(0,7)),selected);
}

function filterRecords(){
  const f=recFilters;
  return RECORDS.filter(r=>
    (!f.q||matchesText(r,f.q))&&
    (!f.review||r.needsReview)&&
    (!f.mat||r.material===f.mat)&&
    (!f.month||r.date.slice(0,7)===f.month)&&
    (!f.date||daysAgo(r.date)<=+f.date)
  );
}

function sortRecords(list){
  if(recFilters.sort==='review-first')return list.sort((a,b)=>(+!!b.needsReview)-(+!!a.needsReview)||b.date.localeCompare(a.date));
  const [key,dir]=recFilters.sort.split('-');
  return list.sort((a,b)=>{
    const r=key==='date'?a.date.localeCompare(b.date):a.wo.localeCompare(b.wo);
    return dir==='d'?-r:r;
  });
}


/* ---- Announcements (company-wide; only administrators can post or delete) ---- */
let ANNS=[];
function annDate(v){const d=new Date(String(v||'').replace(' ','T'));return isNaN(d)?'':d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}
function annAgo(v){const d=new Date(String(v||'').replace(' ','T'));if(isNaN(d))return '';const n=Math.floor((Date.now()-d)/864e5);return n<=0?'Today':n===1?'Yesterday':n<7?n+' days ago':n<14?'Last week':annDate(v)}

/* ---- talking to api/*.php ---- */
async function authApi(path,body){
  const res=await fetch(API_BASE+path,{
    method:'POST',
    credentials:'same-origin',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(Object.assign({},body,{csrf:AUTH.csrf}))
  });
  let data={};
  try{data=await res.json()}catch(e){}
  if(data.csrf)AUTH.csrf=data.csrf;
  if(!res.ok||data.ok===false){
    const err=new Error(data.error||'Something went wrong. Please try again.');
    err.data=data;err.status=res.status;
    throw err;
  }
  return data;
}

async function checkSession(){
  try{
    const res=await fetch(API_BASE+'me.php',{credentials:'same-origin'});
    const data=await res.json();
    AUTH.authenticated=!!data.authenticated;AUTH.user=data.user||null;AUTH.csrf=data.csrf||'';
  }catch(err){
    console.error('Could not reach auth backend:',err);
    AUTH.authenticated=false;AUTH.user=null;AUTH.csrf='';
  }
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Company Portal</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 rx=%227%22 fill=%22%230B3A55%22/%3E%3Cg transform=%22translate%283.2 3.2%29 scale%28.8%29%22%3E%3Cpath d=%22M4 27 12 5h6l-8 22z%22 fill=%22%23fff%22/%3E%3Cpath d=%22M16 27 24 5h4l-8 22z%22 fill=%22%23fff%22 opacity=%22.6%22/%3E%3C/g%3E%3C/svg%3E">
<link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="theme-color" content="#0B3A55">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F9FB;--bg2:#DAE7EF;--streak:rgba(255,255,255,.62);
  --card:#FFFFFF;--card-alt:#F4F8FA;--line:#DAE4EA;--line-strong:#C3D2DC;
  --ink:#0E2333;--muted:#4C6C84;--faint:#84999F;
  --primary:#0B3A55;--primary-hover:#082D43;--on-primary:#FFFFFF;
  --accent:#2F7DB5;--accent-soft:#E3EFF7;--navy:#0A2A42;--hover:#EFF5F8;
  --pass:#1B8657;--pass-bg:#E1F4E9;--pend:#A05C00;--pend-bg:#FFEFD0;--fail:#BE3333;--fail-bg:#FCE6E6;
  --shadow:0 1px 2px rgba(10,42,66,.05),0 6px 18px rgba(10,42,66,.05);
  --btn-shadow:0 6px 16px rgba(10,53,80,.24);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0C1822;--bg2:#0F2231;--streak:rgba(120,170,205,.05);--card:#122636;--card-alt:#16303F;--line:#23394A;--line-strong:#33506A;
  --ink:#E6EFF5;--muted:#93B0C4;--faint:#6D8799;--primary:#3B8AC2;--primary-hover:#4A98D0;--on-primary:#06131C;
  --accent:#5AA6DA;--accent-soft:#183B52;--hover:#183246;--pass:#4CC48C;--pass-bg:#12382B;--pend:#F0B24A;--pend-bg:#3B2E13;--fail:#F27A7A;--fail-bg:#3F1D20;
  --shadow:0 1px 2px rgba(0,0,0,.3);--btn-shadow:0 6px 16px rgba(0,0,0,.35);}}
:root[data-theme="dark"]{
  --bg:#0C1822;--bg2:#0F2231;--streak:rgba(120,170,205,.05);--card:#122636;--card-alt:#16303F;--line:#23394A;--line-strong:#33506A;
  --ink:#E6EFF5;--muted:#93B0C4;--faint:#6D8799;--primary:#3B8AC2;--primary-hover:#4A98D0;--on-primary:#06131C;
  --accent:#5AA6DA;--accent-soft:#183B52;--hover:#183246;--pass:#4CC48C;--pass-bg:#12382B;--pend:#F0B24A;--pend-bg:#3B2E13;--fail:#F27A7A;--fail-bg:#3F1D20;
  --shadow:0 1px 2px rgba(0,0,0,.3);--btn-shadow:0 6px 16px rgba(0,0,0,.35);}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0}
body{font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;color:var(--ink);font-size:14.5px;line-height:1.5;
  background:linear-gradient(135deg,var(--bg) 0%,var(--bg2) 100%) fixed;background-color:var(--bg);min-height:100vh;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;background:linear-gradient(112deg,transparent 0 40%,var(--streak) 40% 54%,transparent 54% 100%)}
h1,h2,h3,h4,p{margin:0}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ic{width:18px;height:18px;flex:none;display:block}
i[data-i]{display:inline-flex;font-style:normal}
[hidden]{display:none!important}

/* ---------- shell ---------- */
.shell{position:relative;z-index:1;display:grid;grid-template-columns:232px minmax(0,1fr);min-height:100vh}
.side{position:sticky;top:0;height:100vh;background:var(--navy);color:#DCE9F2;display:flex;flex-direction:column;padding:22px 14px 18px;z-index:30}
.brand{display:flex;align-items:center;gap:11px;padding:2px 10px 24px}
.brand svg{width:30px;height:30px;color:#fff}
.brand b{display:block;font-size:17px;font-weight:700;color:#fff;letter-spacing:-.01em;line-height:1.15}
.brand small{display:block;font-size:12px;color:#8FB0C6;margin-top:1px}
.nav{display:flex;flex-direction:column;gap:3px}
.nav a{position:relative;display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#B9CFDD;font-weight:500;transition:background .15s,color .15s}
.nav a:hover{background:rgba(255,255,255,.07);color:#fff}
.nav a.on{background:rgba(255,255,255,.12);color:#fff;font-weight:600}
.nav a.on::before{content:"";position:absolute;left:-14px;top:9px;bottom:9px;width:3px;border-radius:0 3px 3px 0;background:#6DB6E8}
.side .spacer{display:none}
.sidescroll{flex:1;min-height:0;width:100%;overflow-y:auto;overflow-x:hidden;margin:0 -4px;padding:0 4px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.28) transparent}
.sidescroll::-webkit-scrollbar{width:6px}
.sidescroll::-webkit-scrollbar-thumb{background:rgba(255,255,255,.25);border-radius:6px}
.sidescroll::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.4)}
.navlabel{margin:18px 12px 6px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6F93AB}
.navgrouphead{display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;border-radius:10px;background:transparent;color:#DCE9F2;font:inherit;font-weight:600;cursor:pointer;text-align:left}
.navgrouphead:hover{background:rgba(255,255,255,.07);color:#fff}
.navgrouphead span{flex:1}
.navchev{display:flex;width:16px;height:16px;transition:transform .3s ease}
.navchev svg{width:16px;height:16px}
.navgroup.collapsed .navchev{transform:rotate(-90deg)}
.navsub{display:grid;grid-template-rows:1fr;opacity:1;margin:2px 0 4px 14px;transition:grid-template-rows .3s ease,opacity .25s ease,margin .3s ease}
.navsubin{min-height:0;overflow:hidden;display:flex;flex-direction:column;gap:3px;padding-left:8px;border-left:1px solid rgba(255,255,255,.12)}
.navgroup.collapsed .navsub{grid-template-rows:0fr;opacity:0;margin-top:0;margin-bottom:0;visibility:hidden;transition:grid-template-rows .3s ease,opacity .2s ease,margin .3s ease,visibility 0s .3s}
.navgrouphead,.navsubin a{transition:background .2s ease,color .2s ease,opacity .2s ease}
@media (prefers-reduced-motion:reduce){.navsub,.navchev,.navgrouphead,.navsubin a{transition:none!important}}
.navgroup.locked .navsub a{opacity:.5;cursor:not-allowed}
.navgroup.locked .navsub a::after{content:"\1F512";margin-left:auto;font-size:12px}
.navgroup.locked .navsub a:hover{background:rgba(255,255,255,.04)}
/* department icons: magnifier glint + gears (very slow, only motion inside the icon) */
.qc-star{transform-box:fill-box;transform-origin:center;animation:qcTwinkle 3.2s ease-in-out infinite}
.qc-glint{animation:qcGlint 3.2s ease-in-out infinite}
@keyframes qcTwinkle{0%,100%{transform:scale(.78) rotate(0);opacity:.75}50%{transform:scale(1.18) rotate(45deg);opacity:1}}
@keyframes qcGlint{0%,100%{opacity:.35}50%{opacity:1}}
.pd-big,.pd-small{transform-box:fill-box;transform-origin:center}
.pd-big{animation:pdSpin 16s linear infinite}
.pd-small{animation:pdSpin 10.7s linear infinite reverse}
@keyframes pdSpin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.qc-star,.qc-glint,.pd-big,.pd-small{animation:none}}
/* Announcements: banner + feed of cards */
.annhero{position:relative;overflow:hidden;display:flex;align-items:center;gap:22px;padding:30px 34px;border-radius:20px;color:#fff;background:radial-gradient(110% 150% at 100% 0%,rgba(124,77,204,.85) 0%,transparent 55%),linear-gradient(135deg,#0A2A3F 0%,#1E4F8C 62%,#3B3FB5 100%);box-shadow:0 18px 40px -20px rgba(30,60,140,.6)}
.annhero::before{content:'';position:absolute;right:-70px;top:-90px;width:270px;height:270px;border-radius:50%;border:36px solid rgba(255,255,255,.07);pointer-events:none}
.annhero::after{content:'';position:absolute;right:150px;bottom:-100px;width:190px;height:190px;border-radius:50%;border:22px solid rgba(255,255,255,.06);pointer-events:none}
.annmega{position:relative;flex:none;width:70px;height:70px;border-radius:22px;display:grid;place-items:center;color:#3B1D00;background:linear-gradient(135deg,#FFE08A,#FF8A4C);box-shadow:0 12px 26px -8px rgba(255,138,76,.7),inset 0 1px 0 rgba(255,255,255,.7)}
.annmega .ic{width:36px;height:36px;animation:annWiggle 5s ease-in-out infinite;transform-origin:30% 60%}
.annmega::before,.annmega::after{content:'';position:absolute;inset:0;border-radius:inherit;border:2px solid rgba(255,190,100,.6);animation:annPing 3.4s ease-out infinite;pointer-events:none}
.annmega::after{animation-delay:1.7s}
@keyframes annPing{0%{transform:scale(1);opacity:.85}100%{transform:scale(1.65);opacity:0}}
@keyframes annWiggle{0%,84%,100%{transform:rotate(0)}88%{transform:rotate(-10deg)}92%{transform:rotate(8deg)}96%{transform:rotate(-4deg)}}
.annhead{position:relative;flex:1;min-width:0}
.annhead h1{margin:0;font-size:34px;line-height:1.1;font-weight:800;letter-spacing:-.02em;color:#fff}
.annhead p{margin:7px 0 0;color:rgba(255,255,255,.8);font-size:15.5px}
.annside{position:relative;display:flex;align-items:center;gap:12px;flex:none}
.anncount{padding:7px 15px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);font-weight:700;font-size:13px;white-space:nowrap}
.annhero .annnewbtn{background:#fff;color:#1E3F7A;border:0;font-weight:700;box-shadow:0 8px 20px -8px rgba(0,0,0,.5)}
.annhero .annnewbtn:hover{background:#FFF3D6}
.anncomp{margin-top:18px;padding:22px 24px;border-radius:18px;border:1px dashed color-mix(in srgb,#7C4DCC 45%,var(--line));background:linear-gradient(135deg,color-mix(in srgb,#7C4DCC 7%,var(--card)),var(--card))}
.anncomp>b{display:flex;align-items:center;gap:8px;font-size:16px}
.anncomp>b .ic{width:20px;height:20px;color:#7C4DCC}
.annfeed{display:grid;gap:16px;margin-top:20px}
.anncard{--ac:#2F80C0;--ac2:#5BB0F0;position:relative;display:flex;gap:18px;padding:20px 22px 20px 26px;border-radius:18px;overflow:hidden;border:1px solid color-mix(in srgb,var(--ac) 22%,var(--line));background:linear-gradient(135deg,color-mix(in srgb,var(--ac) 9%,var(--card)),var(--card) 65%);box-shadow:0 10px 24px -18px color-mix(in srgb,var(--ac) 80%,#000);animation:annIn .55s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(var(--i,0)*80ms);transition:transform .2s,box-shadow .2s}
.anncard:hover{transform:translateY(-2px);box-shadow:0 16px 30px -18px color-mix(in srgb,var(--ac) 90%,#000)}
.anncard::before{content:'';position:absolute;left:0;top:0;bottom:0;width:6px;background:linear-gradient(var(--ac),var(--ac2))}
.annfeed .anncard:nth-child(4n+2){--ac:#1B8657;--ac2:#3FCB92}
.annfeed .anncard:nth-child(4n+3){--ac:#7C4DCC;--ac2:#B38CFF}
.annfeed .anncard:nth-child(4n+4){--ac:#E07B1A;--ac2:#FFB05A}
@keyframes annIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.annic{flex:none;width:46px;height:46px;border-radius:14px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--ac),var(--ac2));box-shadow:0 8px 16px -8px var(--ac)}
.annic .ic{width:24px;height:24px}
.annmain{flex:1;min-width:0}
.annmeta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:12.5px;color:var(--muted)}
.annlatest,.annnew{padding:2px 9px;border-radius:999px;font-size:10.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#fff}
.annlatest{background:linear-gradient(135deg,#7C4DCC,#3B3FB5)}
.annnew{background:linear-gradient(135deg,#FF6B6B,#FF8A4C);animation:annPulse 2.2s ease-in-out infinite}
@keyframes annPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,107,107,.5)}50%{box-shadow:0 0 0 5px rgba(255,107,107,0)}}
.annwho{display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--ink)}
.annav{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:9.5px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--ac),var(--ac2))}
.anndot{width:4px;height:4px;border-radius:50%;background:currentColor;opacity:.5}
.anncard h3{margin:9px 0 0;font-size:21px;line-height:1.25;color:var(--ink)}
.anncard p{margin:8px 0 0;font-size:16px;line-height:1.65;white-space:pre-wrap;color:var(--ink);opacity:.88}
.anncard .btn{margin-top:14px}
.anncard.feat{padding:26px 30px 26px 34px}
.anncard.feat .annic{width:60px;height:60px;border-radius:18px}
.anncard.feat .annic .ic{width:30px;height:30px}
.anncard.feat h3{font-size:28px;line-height:1.2}
.anncard.feat p{font-size:17.5px}
.annempty{display:grid;justify-items:center;gap:10px;padding:46px 20px;text-align:center;color:var(--muted);border:2px dashed var(--line);border-radius:18px}
.annempty .annic{width:64px;height:64px;border-radius:20px;--ac:#7C4DCC;--ac2:#B38CFF}
.annempty .annic .ic{width:32px;height:32px}
.annempty b{color:var(--ink);font-size:18px}
/* Announcement reminder popup (shown for announcements from the last 7 days) */
.annpop{position:fixed;inset:0;z-index:120;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(8,18,40,.62);backdrop-filter:blur(3px);opacity:0;transition:opacity .25s ease}
.annpop.on{opacity:1}
.annpop-card{position:relative;width:100%;max-width:540px;border-radius:28px;padding:3px;background:linear-gradient(120deg,#FFB547,#FF5E8A,#7C4DCC,#3B8BFF,#FFB547);background-size:300% 100%;animation:apBorder 7s linear infinite;box-shadow:0 34px 80px -22px rgba(0,0,0,.65);transform:translateY(26px) scale(.9);transition:transform .5s cubic-bezier(.34,1.56,.64,1)}
.annpop.on .annpop-card{transform:none}
@keyframes apBorder{to{background-position:300% 0}}
.annpop-in{position:relative;border-radius:25px;overflow:hidden;background:var(--card);color:var(--ink)}
.annpop-top{position:relative;display:flex;align-items:center;gap:18px;padding:26px 28px 24px;color:#fff;background:radial-gradient(110% 150% at 100% 0%,rgba(255,138,76,.6),transparent 55%),linear-gradient(135deg,#0A2A3F 0%,#1E4F8C 60%,#3B3FB5 100%)}
.annpop-top .annmega{width:64px;height:64px;border-radius:20px}
.annpop-top .annmega .ic{width:33px;height:33px}
.annpop-rem{display:inline-flex;align-items:center;gap:6px;padding:3px 11px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;background:linear-gradient(135deg,#FFD36B,#FF8A4C);color:#2B1200}
.annpop-top h2{margin:8px 0 0;font-size:22px;line-height:1.15;font-weight:800;color:#fff}
.annpop-top .sp{position:absolute;width:10px;height:10px;background:#fff;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);opacity:.8;animation:swTwinkle 2.6s ease-in-out infinite;pointer-events:none}
.annpop-x{position:absolute;top:12px;right:12px;width:34px;height:34px;border-radius:50%;border:0;cursor:pointer;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.18);transition:background .15s,transform .15s}
.annpop-x:hover{background:rgba(255,255,255,.3);transform:rotate(90deg)}
.annpop-x svg{width:16px;height:16px}
.annpop-body{padding:24px 28px 6px;animation:annIn .4s cubic-bezier(.2,.7,.2,1) both}
.annpop-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:12.5px;color:var(--muted)}
.annpop-body h3{margin:10px 0 0;font-size:26px;line-height:1.2;color:var(--ink)}
.annpop-body p{margin:10px 0 0;font-size:16px;line-height:1.6;color:var(--ink);opacity:.88;white-space:pre-wrap;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:6;overflow:hidden}
.annpop-pager{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 28px 0}
.annpop-dots{display:flex;gap:6px}
.annpop-dots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:all .2s}
.annpop-dots i.on{width:22px;border-radius:99px;background:linear-gradient(90deg,#7C4DCC,#3B8BFF)}
.annpop-pager button{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:5px 14px;font-weight:700;font-size:12.5px;cursor:pointer}
.annpop-pager button:hover{background:var(--accent-soft)}
.annpop-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:16px 28px 24px}
.annpop-foot label{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);cursor:pointer}
.annpop-foot .acts{display:flex;gap:10px}
@media (max-width:520px){.annpop-top{padding:22px 20px}.annpop-body,.annpop-pager,.annpop-foot{padding-left:20px;padding-right:20px}.annpop-body h3{font-size:22px}}
@media (prefers-reduced-motion:reduce){.annpop,.annpop-card,.annpop-body,.annpop-top .sp,.annpop-x{animation:none;transition:none}}
@media (max-width:720px){.annhero{flex-wrap:wrap;padding:24px 22px}.annside{flex:1 1 100%}.annhead h1{font-size:28px}.anncard{flex-direction:column;gap:12px}}
@media (prefers-reduced-motion:reduce){.anncard,.annmega .ic,.annmega::before,.annmega::after,.annnew{animation:none}}
.dtag{--dc1:#3730A3;--dc2:#4F46E5;position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:7px;padding:3px 13px 3px 10px;border-radius:999px;border:1px solid color-mix(in srgb,var(--dc1) 75%,#000);background:linear-gradient(135deg,var(--dc1),var(--dc2));color:#fff;font-size:12px;font-weight:700;letter-spacing:.01em;text-transform:none;line-height:1.55;white-space:nowrap;vertical-align:middle;text-shadow:0 1px 1px rgba(0,0,0,.35);box-shadow:inset 0 1px 0 rgba(255,255,255,.55),0 2px 8px color-mix(in srgb,var(--dc1) 45%,transparent)}
.dtag::before{content:'';width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 6px 2px rgba(255,255,255,.75);flex:none}
.dtag::after{content:'';position:absolute;top:0;bottom:0;width:38%;left:-60%;background:linear-gradient(110deg,transparent,rgba(255,255,255,.65),transparent);transform:skewX(-20deg);animation:dtshine 3.8s ease-in-out infinite;pointer-events:none}
@keyframes dtshine{0%,55%{left:-60%}100%{left:135%}}
@media (prefers-reduced-motion:reduce){.dtag::after{animation:none;display:none}}
.userchip .dtag{margin-top:5px}
.evc{min-width:50px;padding:5px 9px;border:0;border-radius:12px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
span.evc{cursor:default;display:inline-block}
.evc.gr{background:#D3F0DF;color:#14663F}.evc.am{background:#FFEBC2;color:#7A4A00}.evc.rd{background:#FBD5D5;color:#A3262B}.evc.gy{background:#EEF2F5;color:#4F6070}.evc.inc{background:#fff;color:#7A4A00;border:1px dashed #D9822B}
.t.evt th,.t.evt td{text-align:center}.t.evt th:first-child,.t.evt td:first-child{text-align:left}
.evdet{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 20px;margin-top:12px}.evdet>div>span{display:block;color:var(--muted);font-size:12px;margin-bottom:2px}
.evtabs{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.evm{padding:7px 14px;border-radius:8px;border:1px solid var(--line);background:var(--card);font:inherit;font-weight:700;cursor:pointer}
.evm.on{background:#0A2A3F;color:#fff;border-color:#0A2A3F}.evm.has::after{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:#1B8657;margin-left:6px;vertical-align:middle}
.evbox{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:14px}.evbox.off{opacity:.55}
.evbh{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.evn{width:32px;height:32px;border-radius:50%;background:#0A2A3F;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;flex:none}
.evbd{display:grid;grid-template-columns:1fr 300px;gap:16px}
.evct{border:1px solid #9FB3C2;border-radius:8px;overflow:hidden;font-size:13px;align-self:start}

function buildEvaluationData(S,workers,calcs){
  var sh=new Sheet('Evaluation Data Surface',S); sh.tab='1E6FA8';
  sh.widths[1]=34; for(var c=2;c<=14;c++) sh.widths[c]=9;
  var H={b:true,fill:LILAC,al:'center',wrap:true}, HL={b:true,fill:LILAC,al:'left',wrap:true}, CE={al:'center'}, RS={al:'center',fill:PEACH};
  var blocks=[['1. Output Efficiency (Score 100)',function(k){return k.outAvg;}],['2. Quality Control (Score 30)',function(k){return k.qcAvg;}],['3. Attendance (Score 20)',function(k){return k.att.score;}],
    ['4. Process & Drawing Understanding, Self Discipline, Co-Operation, Compliance & Obedience (Score 15)',function(k){return k.process;}],['5. Maintenance (Score 5)',function(k){return k.maintenance;}],
    ['6. Problem Solving (For Grade A & B Only) (Score 5)',function(k){return k.useAB?k.problem:null;}],['7. Corrective Proposal Form Accepted (For Grade A & B Only) (Score 5)',function(k){return k.useAB?k.corrective:null;}],
    ['8. Lead & Guide Team Member (For Grade A Only) (Score 10)',function(k){return k.useA?k.leadership:null;}],['Assessment KPI Operator (Total Score)',function(k){return k.total;}],['Monthly Performance (%)',function(k){return k.pct;}]];
  var r=1;
  blocks.forEach(function(b,bi){
    sh.put(r,1,b[0],HL); for(var m=1;m<=12;m++) sh.put(r,1+m,MON3[m-1],H);
    var isPct=(bi===9); if(isPct) sh.put(r,14,'Average',H);
    sh.heights[r]=(b[0].length>45)?42:20;
    workers.forEach(function(w,wi){ var rr=r+1+wi; sh.put(rr,1,w.emp_no,{al:'left'});
      for(var m=1;m<=12;m++){ var k=calcs[wi].months[m-1]; var val=k.has?b[1](k):null; sh.put(rr,1+m,(val===null||val===undefined)?null:val,isPct?{al:'center',fmt:'0.0%'}:CE); }
      if(isPct) sh.put(rr,14,calcs[wi].avgPct,{al:'center',fmt:'0.0%',b:true,fill:PEACH});
    });
    r+=workers.length+1;
    if(bi===8){ /* average row for the total block */
      sh.put(r,1,'Average',{b:true,fill:PEACH});
      for(var m2=1;m2<=12;m2++){ var s=0,n=0; calcs.forEach(function(cc){ var k=cc.months[m2-1]; if(k.has&&k.total>0){s+=k.total;n++;} }); sh.put(r,1+m2,n?round2(s/n):null,{al:'center',b:true,fill:PEACH}); }
      r+=2;
    } else r+=1;
  });
  sh.freeze=[2,2];
  return sh;
}

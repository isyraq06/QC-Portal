  r.qc1=qcHalf(rec.reject_h1,rec.rework_h1); r.qc2=qcHalf(rec.reject_h2,rec.rework_h2); r.qcAvg=halfAvg(r.qc1,r.qc2);
  r.att=attendance(rec);
  var p=['drawing','skill','cooperation','obey','rules','colleagues'], psum=0, pAny=false, pAll=true;
  p.forEach(function(k){ var v=num(rec[k]); if(v===null){pAll=false;} else {pAny=true; psum+=v;} });
  r.process=pAny?psum:null;
  r.maintenance=num(rec.maintenance);
  r.useAB=(grade==='A'||grade==='B'); r.useA=(grade==='A');
  r.problem=r.useAB?num(rec.problem_solving):null;
  r.corrective=r.useAB?num(rec.corrective):null;
  r.leadership=r.useA?num(rec.leadership):null;
  var total=0;
  [r.outAvg,r.qcAvg,r.att.score,r.process,r.maintenance,r.problem,r.corrective,r.leadership].forEach(function(x){ if(x!==null) total+=x; });
  r.total=round2(total);
  r.pct=r.total/max;
  var missing=[];
  if(r.out1===null) missing.push('Output 1st~15th');
  if(r.out2===null) missing.push('Output 16th~31st');
  if(r.qc1===null) missing.push('Quality 1st~15th');
  if(r.qc2===null) missing.push('Quality 16th~31st');
  if(!pAll) missing.push('Process & drawing');
  if(r.maintenance===null) missing.push('Maintenance');
  if(r.useAB && r.problem===null) missing.push('Problem solving');
  if(r.useAB && r.corrective===null) missing.push('Corrective proposal');
  if(r.useA && r.leadership===null) missing.push('Team leadership');

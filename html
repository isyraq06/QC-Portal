/* Owner badge: diamond shine + sci-fi frame (pearl border with a running highlight, winged tips, neon glow) */
@property --rfa{syntax:'<angle>';inherits:false;initial-value:0deg}
.tag.owner{position:relative;overflow:visible;margin:7px 12px;
  background:linear-gradient(100deg,transparent 42%,rgba(255,255,255,.95) 50%,transparent 58%) -120% 0/60% 100% no-repeat,linear-gradient(135deg,#EAFBFF,#9FE3F7 45%,#DDF7FF 70%,#B7D6FF);
  border-color:#6CC4E6;color:#0B4A66;
  box-shadow:0 0 12px rgba(90,200,240,.6),inset 0 0 0 1px rgba(255,255,255,.75),inset 0 0 8px rgba(56,232,255,.5);
  animation:diamondShine 3.2s ease-in-out infinite}
@keyframes diamondShine{0%,55%{background-position:-120% 0,0 0}100%{background-position:220% 0,0 0}}
.tag.owner::before{content:'';position:absolute;inset:-5px;border-radius:10px;padding:2px;pointer-events:none;
  background:conic-gradient(from var(--rfa),rgba(255,255,255,0) 0deg,rgba(255,255,255,0) 210deg,#fff 300deg,rgba(255,255,255,0) 345deg),linear-gradient(120deg,#5FE8FF,#8B6CFF 40%,#FF7FD9 70%,#E9F7FF);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
  mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);
